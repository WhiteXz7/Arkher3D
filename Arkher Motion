    else names={"Valor"};values={v} end
    if fieldKind~="CFrame" then fieldHint.Text="Altere os campos → Aplicar → + Key. Uma chave sozinha mantém o valor durante toda a cena." end
    if fieldKind=="NumberSequence" or fieldKind=="ColorSequence" then fieldHint.Text="Aplicar recria a sequência com 2 pontas. + Key sem aplicar preserva todos os pontos da sequência original." end
    local cols=(fieldKind=="string" or fieldKind=="boolean") and 1 or math.min(3,#names)
    for i,n in ipairs(names) do
