                    if t>=f.start-1e-8 and t<=f.finish+1e-8 then
                        root,velocity=PhysicsMath.flightFrame(from,to,f.start,f.finish,t,f.gravity)
                    elseif t<f.start then root=from*at(input,f.start):Inverse()*inputRoot
