    local p={};for _,v in ipairs(points) do p[#p+1]=Vector2.new(v.X,v.Y) end
    table.sort(p,function(a,b) return a.X==b.X and a.Y<b.Y or a.X<b.X end)
    local unique={}
    for _,v in ipairs(p) do if #unique==0 or dist2(v,unique[#unique])>1e-12 then unique[#unique+1]=v end end
    if #unique<=2 then return unique end
    local lower,upper={},{}
    for _,v in ipairs(unique) do
        while #lower>=2 and cross(lower[#lower-1],lower[#lower],v)<=1e-10 do table.remove(lower) end
        lower[#lower+1]=v
    end
    for i=#unique,1,-1 do
        local v=unique[i]
        while #upper>=2 and cross(upper[#upper-1],upper[#upper],v)<=1e-10 do table.remove(upper) end
        upper[#upper+1]=v
    end
    table.remove(lower);table.remove(upper)
    for _,v in ipairs(upper) do lower[#lower+1]=v end
    return lower
end
function PhysicsMath.inset(poly,margin)
    if #poly<3 then return {} end
    local result={};for _,v in ipairs(poly) do result[#result+1]=v end
    for i,a in ipairs(poly) do
        local b=poly[i%#poly+1];local length=math.sqrt(dist2(a,b))
        if length>1e-8 then
            local output={}
            local function side(p) return cross(a,b,p)/length-margin end
            if #result==0 then return {} end
            local prev=result[#result];local dp=side(prev)
            for _,cur in ipairs(result) do
                local dc=side(cur)
                if (dp>=-1e-8)~=(dc>=-1e-8) then
                    local t=dp/(dp-dc)
                    output[#output+1]=Vector2.new(prev.X+(cur.X-prev.X)*t,prev.Y+(cur.Y-prev.Y)*t)
                end
