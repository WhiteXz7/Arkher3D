        assert(type(l)=="table" and (l.mode=="free" or l.mode=="hinge" or l.mode=="cone"),"Tipo de limite inválido")
        vector(l.axis);assert(math.abs(l.axis[1])+math.abs(l.axis[2])+math.abs(l.axis[3])>.0001,"Eixo de limite nulo")
        number(l.min,-180,180);number(l.max,l.min,180);number(l.cone,0,180)
    end
    for _,e in ipairs(body.effectors) do
        assert(type(e.name)=="string" and #e.name<=80,"Nome Body inválido")
        assert(type(e.chain)=="table" and #e.chain>=2 and #e.chain<=12,"Cadeia Body: 2–12 juntas")
        for _,loc in ipairs(e.chain) do locator(loc) end
        locator(e.tip);vector(e.offset);vector(e.target);vector(e.pole);value(e.rotation,"CFrame")
        number(e.weight,0,1);number(e.priority or 1,1,10)
