-- Snake Motion Assist 4: geometria de apoio e trajetória, sem simulação do motor físico.
local PhysicsMath={}
local function cross(a,b,c) return (b.X-a.X)*(c.Y-a.Y)-(b.Y-a.Y)*(c.X-a.X) end
local function dist2(a,b) local x,y=a.X-b.X,a.Y-b.Y;return x*x+y*y end
