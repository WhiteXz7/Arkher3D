end
function Snake.resolve(loc)
    local node
    if loc.root=="Camera" then return Workspace.CurrentCamera end
    if loc.root=="Character" then
        local p=Players:GetPlayerByUserId(loc.userId or 0)
        node=p and p.Character
    elseif loc.root=="Workspace" then node=Workspace
    elseif loc.root=="Lighting" then node=Lighting
    elseif loc.root=="SoundService" then node=SoundService end
    for _,seg in ipairs(loc.path or {}) do
        if not node then return nil end
        local count,found=0,nil
        for _,c in ipairs(node:GetChildren()) do
            if c.Name==seg.name and c.ClassName==seg.class then
                count=count+1
                if count==(seg.index or 1) then found=c;break end
            end
        end
        node=found
    end
    return node
end
function Snake.read(obj,prop)
