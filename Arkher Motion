    elseif fieldKind=="ColorSequence" then
        local a,b=v.Keypoints[1].Value,v.Keypoints[#v.Keypoints].Value
        names={"Início R","Início G","Início B","Fim R","Fim G","Fim B"};values={a.R*255,a.G*255,a.B*255,b.R*255,b.G*255,b.B*255}
    elseif fieldKind=="boolean" then names={"Booleano: true / false"};values={tostring(v)}
