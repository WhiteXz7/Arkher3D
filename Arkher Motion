function Snake.pack(v)
    local kind = typeof(v)
    if kind == "number" or kind == "boolean" or kind == "string" then return {kind=kind, data=v} end
    if kind == "CFrame" then return {kind=kind, data={v:GetComponents()}} end
    if kind == "UDim2" then return {kind=kind,data={v.X.Scale,v.X.Offset,v.Y.Scale,v.Y.Offset}} end
    if kind == "UDim" then return {kind=kind,data={v.Scale,v.Offset}} end
    if kind == "Vector3" then return {kind=kind, data={v.X,v.Y,v.Z}} end
    if kind == "Vector2" then return {kind=kind, data={v.X,v.Y}} end
    if kind == "Color3" then return {kind=kind, data={v.R,v.G,v.B}} end
    if kind == "NumberRange" then return {kind=kind, data={v.Min,v.Max}} end
    if kind == "NumberSequence" then
        local data={}
        for _,k in ipairs(v.Keypoints) do table.insert(data,{k.Time,k.Value,k.Envelope}) end
        return {kind=kind,data=data}
    end
    if kind == "ColorSequence" then
        local data={}
        for _,k in ipairs(v.Keypoints) do table.insert(data,{k.Time,k.Value.R,k.Value.G,k.Value.B}) end
        return {kind=kind,data=data}
    end
    error("Tipo nao suportado: "..kind)
end

function Snake.unpack(v)
    local k,d=v.kind,v.data
    if k=="number" or k=="boolean" or k=="string" then return d end
    if k=="CFrame" then return CFrame.new(table.unpack(d)) end
    if k=="UDim2" then return UDim2.new(d[1],d[2],d[3],d[4]) end
    if k=="UDim" then return UDim.new(d[1],d[2]) end
    if k=="Vector3" then return Vector3.new(d[1],d[2],d[3]) end
    if k=="Vector2" then return Vector2.new(d[1],d[2]) end
    if k=="Color3" then return Color3.new(d[1],d[2],d[3]) end
    if k=="NumberRange" then return NumberRange.new(d[1],d[2]) end
    if k=="NumberSequence" then
        local keys={}
        for _,x in ipairs(d) do table.insert(keys,NumberSequenceKeypoint.new(x[1],x[2],x[3] or 0)) end
        return NumberSequence.new(keys)
    end
    if k=="ColorSequence" then
        local keys={}
        for _,x in ipairs(d) do table.insert(keys,ColorSequenceKeypoint.new(x[1],Color3.new(x[2],x[3],x[4]))) end
        return ColorSequence.new(keys)
    end
    error("Valor de projeto invalido")
end

local function segment(obj)
