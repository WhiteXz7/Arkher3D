    local function component(t,a,b)
        local inv=1-t
        return 3*inv*inv*t*a+3*inv*t*t*b+t*t*t
    end
    -- Inverte x(t); nao confunde tempo real com parametro da curva.
    local lo,hi=0,1
    for _=1,24 do
        local m=(lo+hi)/2
        if component(m,x1,x2)<u then lo=m else hi=m end
    end
    return component((lo+hi)/2,y1,y2)
end
function Snake.ease(u,mode,curve)
    if mode=="bezier" then return Snake.bezier(u,curve) end
    if mode=="hold" then return 0 end
    if mode=="smooth" then return u*u*(3-2*u) end
    if mode=="smoother" then return u*u*u*(u*(u*6-15)+10) end
    if mode=="in" then return u*u end
    if mode=="out" then return 1-(1-u)*(1-u) end
    if mode=="inout" then
        if u<0.5 then return 2*u*u end
        return 1-((-2*u+2)^2)/2
    end
    return u
end
local function mix(a,b,u)
    local kind=typeof(a)
    if kind~=typeof(b) then return a end
    if kind=="number" then return a+(b-a)*u end
    if kind=="CFrame" or kind=="Vector3" or kind=="Vector2" or kind=="Color3" then return a:Lerp(b,u) end
    if kind=="NumberRange" then return NumberRange.new(a.Min+(b.Min-a.Min)*u,a.Max+(b.Max-a.Max)*u) end
    if kind=="NumberSequence" or kind=="ColorSequence" then
        local ka,kb=a.Keypoints,b.Keypoints
        if #ka~=#kb then return a end
        local result={}
        for i,x in ipairs(ka) do
            if math.abs(x.Time-kb[i].Time)>0.0001 then return a end
            if kind=="NumberSequence" then
                result[i]=NumberSequenceKeypoint.new(x.Time,x.Value+(kb[i].Value-x.Value)*u,x.Envelope+(kb[i].Envelope-x.Envelope)*u)
            else result[i]=ColorSequenceKeypoint.new(x.Time,x.Value:Lerp(kb[i].Value,u)) end
        end
        if kind=="NumberSequence" then return NumberSequence.new(result) end
        return ColorSequence.new(result)
    end
    return a -- Strings e booleanos trocam exatamente no proximo keyframe.
end
local function hermite(p0,p1,m0,m1,u,dt)
    local u2,u3=u*u,u*u*u
    return p0*(2*u3-3*u2+1)+m0*((u3-2*u2+u)*dt)+p1*(-2*u3+3*u2)+m1*((u3-u2)*dt)
