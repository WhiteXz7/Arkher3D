-- Snake Motion Math 2.0: geometria de IK sem dependencia de UI/Instances.
local MotionMath={}
local EPS=1e-7
local function perpendicular(u,hint)
    local projected=hint-u*hint:Dot(u)
    if projected.Magnitude<EPS then
        local axis=math.abs(u.X)<.8 and Vector3.new(1,0,0) or Vector3.new(0,1,0)
        projected=axis-u*axis:Dot(u)
    end
    return projected.Unit
end
function MotionMath.rotationBetween(a,b,hint)
    assert(a.Magnitude>EPS and b.Magnitude>EPS,"Vetor de comprimento zero")
    a,b=a.Unit,b.Unit
    local dot=math.clamp(a:Dot(b),-1,1)
    local cross=a:Cross(b)
    if cross.Magnitude<EPS then
        if dot>0 then return CFrame.identity end
        return CFrame.fromAxisAngle(perpendicular(a,hint or Vector3.new(0,1,0)),math.pi)
    end
    return CFrame.fromAxisAngle(cross.Unit,math.acos(dot))
end
function MotionMath.solveTwoBone(parentWorld,rootC0,rootC1,midC0,midC1,endLocal,target,pole)
    local rootWorld=parentWorld*rootC0
    local upperWorld=rootWorld*rootC1:Inverse()
    local midWorld=upperWorld*midC0
    local lowerWorld=midWorld*midC1:Inverse()
    local r,m,e=rootWorld.Position,midWorld.Position,lowerWorld:PointToWorldSpace(endLocal)
    local l1,l2=(m-r).Magnitude,(e-m).Magnitude
    assert(l1>.0001 and l2>.0001,"IK precisa de dois segmentos com comprimento positivo")
    local delta=target-r
    local d=delta.Magnitude
    local direction
    if d>EPS then direction=delta/d
    elseif (e-r).Magnitude>EPS then direction=(e-r).Unit
    else direction=Vector3.new(0,-1,0) end
    local reach=math.clamp(d,math.abs(l1-l2)+.000001,l1+l2-.000001)
    local bend=perpendicular(direction,pole-r)
    local along=(l1*l1-l2*l2+reach*reach)/(2*reach)
    local height=math.sqrt(math.max(0,l1*l1-along*along))
    local wantedMid=r+direction*along+bend*height
    local wantedEnd=r+direction*reach
    local rot1=MotionMath.rotationBetween(m-r,wantedMid-r,bend)
    local newRootWorld=CFrame.new(r)*rot1*(rootWorld-rootWorld.Position)
    local newUpper=newRootWorld*rootC1:Inverse()
    local rotatedMid=newUpper*midC0
    local rotatedEnd=(rotatedMid*midC1:Inverse()):PointToWorldSpace(endLocal)
    local rot2=MotionMath.rotationBetween(rotatedEnd-rotatedMid.Position,wantedEnd-rotatedMid.Position,bend)
    local newMidWorld=CFrame.new(rotatedMid.Position)*rot2*(rotatedMid-rotatedMid.Position)
    return parentWorld:ToObjectSpace(newRootWorld),newUpper:ToObjectSpace(newMidWorld),{
        root=r,middle=wantedMid,endpoint=wantedEnd,requested=target,
        unreachable=math.abs(d-reach)>.0001,length1=l1,length2=l2,
        error=(wantedEnd-target).Magnitude,
    }
end
function MotionMath.mirrorCFrame(cf)
    local x,y,z,a,b,c,d,e,f,g,h,i=cf:GetComponents()
    -- S*R*S com S=diag(-1,1,1): reflexao sagital com orientacao valida.
    return CFrame.new(-x,y,z,a,-b,-c,-d,e,f,-g,h,i)
