local function installCameraGuard()
    local K={owners={},snapshots={},hooks={},active=false,writing=false};V5.camera=K
    local binding="SnakeAnimator_GizmoCamera_51"
    local action="SnakeAnimator_GizmoInput_51"
    local context
    pcall(function() context=game:GetService("ContextActionService") end)
    local function restore(camera,state)
        if not camera or not camera.Parent then return end
        pcall(function()
            camera.CFrame=state.cf;camera.Focus=state.focus;camera.FieldOfView=state.fov
            camera.CameraSubject=state.subject;camera.CameraType=state.kind
        end)
    end
    function K.enforce()
        if not K.active or K.writing then return end
        local camera=Workspace.CurrentCamera;if not camera or not camera.Parent then return end
        K.writing=true
        local ok=pcall(function()
            local state=K.snapshots[camera]
            if not state then
                state={cf=camera.CFrame,focus=camera.Focus,fov=camera.FieldOfView,subject=camera.CameraSubject,kind=camera.CameraType}
                K.snapshots[camera]=state
                for _,prop in ipairs({"CFrame","Focus","FieldOfView","CameraType"}) do
                    K.hooks[#K.hooks+1]=camera:GetPropertyChangedSignal(prop):Connect(K.enforce)
                end
            end
            if camera.CameraType~=Enum.CameraType.Scriptable then camera.CameraType=Enum.CameraType.Scriptable end
            if camera.CFrame~=state.cf then camera.CFrame=state.cf end
            if camera.Focus~=state.focus then camera.Focus=state.focus end
            if camera.FieldOfView~=state.fov then camera.FieldOfView=state.fov end
        end)
        K.writing=false
        if not ok then K.releaseAll() end
    end
    function K.acquire(owner)
        K.owners[owner]=true
        if K.active then return end
        K.active=true;K.mouse=UserInputService.MouseBehavior
        pcall(function() UserInputService.MouseBehavior=Enum.MouseBehavior.Default end)
        if context then pcall(function()
            context:BindActionAtPriority(action,function() return K.active and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass end,false,5000,
                Enum.UserInputType.Touch,Enum.UserInputType.MouseMovement,Enum.UserInputType.MouseButton2,Enum.UserInputType.MouseWheel)
        end) end
        K.bound=pcall(function() RunService:BindToRenderStep(binding,2100,K.enforce) end)
        K.enforce()
    end
    function K.releaseAll()
        if not K.active then K.owners={};return end
        K.active=false;K.owners={}
        if K.bound then pcall(function() RunService:UnbindFromRenderStep(binding) end) end;K.bound=false
        if context then pcall(function() context:UnbindAction(action) end) end
        for _,c in ipairs(K.hooks) do c:Disconnect() end;K.hooks={}
        for camera,state in pairs(K.snapshots) do restore(camera,state) end;K.snapshots={}
        if K.mouse~=nil then pcall(function() UserInputService.MouseBehavior=K.mouse end) end
        V5.ignorePickUntil=os.clock()+.2
    end
    function K.release(owner)
        K.owners[owner]=nil
        if next(K.owners)==nil then K.releaseAll() end
    end
    -- Fallback para ambientes sem BindToRenderStep e recuperação de CurrentCamera trocada.
    connect(RunService.RenderStepped,K.enforce)
    function K.pointerEnded(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 then return true end
        if input.UserInputType~=Enum.UserInputType.Touch then return false end
        local ok,touches=pcall(function() return UserInputService:GetTouches() end)
        if not ok then return false end
        for _,t in ipairs(touches) do if t~=input and t.UserInputState~=Enum.UserInputState.End and t.UserInputState~=Enum.UserInputState.Cancel then return false end end
        return true
    end
    connect(UserInputService.InputEnded,function(input)
        if K.pointerEnded(input) then K.releaseAll() end
    end)
    connect(UserInputService.WindowFocusReleased,function()
        if V5.cancel then V5.cancel() end
        K.releaseAll()
    end)
    connect(gui.Destroying,K.releaseAll)
end
