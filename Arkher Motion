    if cam and not cameraSnapshot then cameraSnapshot={cf=cam.CFrame,fov=cam.FieldOfView,kind=cam.CameraType,subject=cam.CameraSubject} end
end
stopPreview=function(restore)
    playing=false;playButton.Text="▶ Play"
    if advancedHooks.previewStopped then advancedHooks.previewStopped(restore) end
    if restore then restoreOriginals();playhead=0 end
    releaseCamera()
    if refreshInspector then refreshInspector() end
end
previewAt=function(t,updateFields)
    playhead=math.clamp(t,0,project.duration)
    if cameraPreview then ownCamera() end
    Snake.apply(compiled,playhead,cameraPreview)
    timeBox.Text=string.format("%.3f",playhead)
    if updateFields then refreshInspector() end
    if advancedHooks.timeChanged then advancedHooks.timeChanged(updateFields) end
end
local function playPause()
    if playing then stopPreview(false);notify("Pausado.");return end
    if #project.tracks==0 then notify("Crie pelo menos uma faixa com keyframes.",true);return end
    if playhead>=project.duration then playhead=0 end
    rebuild();playStart=os.clock()-playhead;playing=true;playButton.Text="Ⅱ Pause"
    if cameraPreview then ownCamera() end
end

