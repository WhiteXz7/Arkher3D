    elseif fieldKind=="Vector2" then names={"X","Y"};values={v.X,v.Y}
    elseif fieldKind=="Color3" then names={"R (0–255)","G (0–255)","B (0–255)"};values={v.R*255,v.G*255,v.B*255}
    elseif fieldKind=="NumberRange" then names={"Mínimo","Máximo"};values={v.Min,v.Max}
