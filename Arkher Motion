local function properties(obj)
    local result={}
    local function add(...)
        for _,prop in ipairs({...}) do
            local ok,v=pcall(Snake.read,obj,prop)
            if ok and pcall(Snake.pack,v) then table.insert(result,prop) end
        end
    end
    if obj:IsA("Camera") then add("CFrame","FieldOfView")
    elseif obj:IsA("JointInstance") then add("C0")
    elseif obj:IsA("Bone") then add("Transform")
    elseif obj:IsA("Model") then add("Pivot")
    elseif obj:IsA("Tool") then add("ToolPivot")
    elseif obj:IsA("BasePart") then add("CFrame","Size","Color","Transparency","Reflectance");if obj:IsA("MeshPart") then add("TextureID") end
    elseif obj:IsA("Attachment") then add("CFrame")
    elseif obj:IsA("ParticleEmitter") then add("Enabled","Rate","Speed","Lifetime","Size","Transparency","Color","Acceleration","Drag","Rotation","RotSpeed","SpreadAngle","LightEmission","LightInfluence","TimeScale","Brightness")
    elseif obj:IsA("Beam") then add("Enabled","Width0","Width1","CurveSize0","CurveSize1","Color","Transparency","TextureSpeed")
    elseif obj:IsA("Trail") then add("Enabled","Lifetime","MinLength","WidthScale","Color","Transparency")
    elseif obj:IsA("Light") then add("Enabled","Brightness","Range","Angle","Color","Shadows")
    elseif obj:IsA("Fire") then add("Enabled","Heat","Size","Color","SecondaryColor")
    elseif obj:IsA("Smoke") then add("Enabled","Opacity","RiseVelocity","Size","Color")
    elseif obj:IsA("Sparkles") then add("Enabled","SparkleColor")
    elseif obj:IsA("Decal") or obj:IsA("Texture") then add("Texture","Transparency","Color3")
    elseif obj:IsA("Shirt") then add("ShirtTemplate")
    elseif obj:IsA("Pants") then add("PantsTemplate")
    elseif obj:IsA("ShirtGraphic") then add("Graphic")
    elseif obj:IsA("BodyColors") then add("HeadColor3","LeftArmColor3","RightArmColor3","LeftLegColor3","RightLegColor3","TorsoColor3")
    elseif obj:IsA("SpecialMesh") then add("Scale","Offset","TextureId")
    elseif obj:IsA("Sound") then add("Volume","PlaybackSpeed")
    elseif obj==Lighting then add("ClockTime","Brightness","ExposureCompensation","FogStart","FogEnd","FogColor","Ambient","OutdoorAmbient")
    elseif obj:IsA("Atmosphere") then add("Density","Offset","Color","Decay","Glare","Haze")
    elseif obj:IsA("ColorCorrectionEffect") then add("Enabled","Brightness","Contrast","Saturation","TintColor")
    elseif obj:IsA("BloomEffect") then add("Enabled","Intensity","Size","Threshold")
    elseif obj:IsA("BlurEffect") then add("Enabled","Size")
    elseif obj:IsA("DepthOfFieldEffect") then add("Enabled","FocusDistance","InFocusRadius","NearIntensity","FarIntensity") end
    return result
end
