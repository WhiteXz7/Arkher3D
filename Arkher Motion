        if pg and (obj==pg or obj:IsDescendantOf(pg)) then root=pg;rootName="PlayerGui" end
    end
    if not root then
        for _,pair in ipairs({{Workspace,"Workspace"},{Lighting,"Lighting"},{SoundService,"SoundService"}}) do
            if obj==pair[1] or obj:IsDescendantOf(pair[1]) then root=pair[1];rootName=pair[2];break end
        end
    end
    assert(root,"Use objetos em Workspace, Lighting, SoundService ou PlayerGui")
