connect(UserInputService.InputChanged,safe(function(input)
    local mouse=input.UserInputType==Enum.UserInputType.MouseMovement
    local touch=input.UserInputType==Enum.UserInputType.Touch
    if not mouse and not touch then return end
    if headerDrag and (mouse or input==headerDrag.input) then
