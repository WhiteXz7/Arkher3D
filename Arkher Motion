    if typeof(value)=="Vector3" then return channel==2 and value.Y or (channel==3 and value.Z or value.X) end
    error("Grafico de valores: use numero, Vector3 ou posicao CFrame")
end
function MotionMath.withChannel(value,channel,n)
    if typeof(value)=="number" then return n end
    local p=typeof(value)=="CFrame" and value.Position or value
    assert(typeof(p)=="Vector3","Canal nao suportado")
    local new=Vector3.new(channel==1 and n or p.X,channel==2 and n or p.Y,channel==3 and n or p.Z)
    if typeof(value)=="CFrame" then return CFrame.new(new)*(value-value.Position) end
    return new
end

-- Snake Body Solver 3: CCD multi-efetor cinemático. Não é física/biomecânica.
local BodyMath={}
local function rotation(cf) return cf-cf.Position end
function BodyMath.quaternion(cf)
    local _,_,_,a,b,c,d,e,f,g,h,i=cf:GetComponents()
    local x,y,z,w
    local tr=a+e+i
    if tr>0 then local s=math.sqrt(tr+1)*2;w=s/4;x=(h-f)/s;y=(c-g)/s;z=(d-b)/s
    elseif a>e and a>i then local s=math.sqrt(math.max(0,1+a-e-i))*2;x=s/4;y=(b+d)/s;z=(c+g)/s;w=(h-f)/s
    elseif e>i then local s=math.sqrt(math.max(0,1+e-a-i))*2;y=s/4;x=(b+d)/s;z=(f+h)/s;w=(c-g)/s
    else local s=math.sqrt(math.max(0,1+i-a-e))*2;z=s/4;x=(c+g)/s;y=(f+h)/s;w=(d-b)/s end
    if w<0 then x,y,z,w=-x,-y,-z,-w end
    return Vector3.new(x,y,z),w
end
function BodyMath.axisAngle(cf)
    local v,w=BodyMath.quaternion(cf)
    if v.Magnitude<1e-9 then return Vector3.xAxis,0 end
    return v.Unit,2*math.atan2(v.Magnitude,math.clamp(w,-1,1))
end
function BodyMath.fraction(cf,u)
    local axis,angle=BodyMath.axisAngle(cf)
    return CFrame.fromAxisAngle(axis,angle*u)
end
function BodyMath.limit(candidate,rest,limit)
    if not limit or limit.mode=="free" then return candidate end
    local axis=Vector3.new(table.unpack(limit.axis or {1,0,0})).Unit
    local delta=rotation(rest):Inverse()*rotation(candidate)
    local q,w=BodyMath.quaternion(delta)
    local projection=q:Dot(axis)
    local length=math.sqrt(projection*projection+w*w)
    local angle=length<1e-9 and 0 or 2*math.atan2(projection/length,w/length)
    angle=(angle+math.pi)%(2*math.pi)-math.pi
    local clamped=math.clamp(angle,math.rad(limit.min or -180),math.rad(limit.max or 180))
    local twist=CFrame.fromAxisAngle(axis,angle)
    local result=CFrame.fromAxisAngle(axis,clamped)
    if limit.mode=="cone" then
        local swing=delta*twist:Inverse()
        local sa,sv=BodyMath.axisAngle(swing)
        result=CFrame.fromAxisAngle(sa,math.min(sv,math.rad(limit.cone or 180)))*result
    end
    return CFrame.new(candidate.Position)*rotation(rest)*result
end
function BodyMath.worldGetter(model)
    local cache,visiting={},{}
    local function world(part)
        if cache[part] then return cache[part] end
        assert(not visiting[part],"Ciclo no grafo de juntas")
        visiting[part]=true
        local index=model.inbound[part]
        local cf
        if index then
            local n=model.nodes[index]
            cf=world(n.parent)*n.c0*(n.transform or CFrame.identity)*n.c1:Inverse()
        else cf=assert(model.bases[part],"Raiz sem transformação") end
        cache[part]=cf;visiting[part]=nil;return cf
    end
    return world
end
function BodyMath.point(model,e)
    return BodyMath.worldGetter(model)(e.part):PointToWorldSpace(e.offset)
end
local function state(model)
    local values={};for i,n in ipairs(model.nodes) do values[i]=n.c0 end;return values
end
local function restore(model,values)
    for i,v in ipairs(values) do model.nodes[i].c0=v end
end
function BodyMath.solve(model,effectors,options)
    options=options or {}
    local active,controlled={},{}
    for _,e in ipairs(effectors) do
        if e.weight>0 then
            for _,index in ipairs(e.chain) do controlled[index]=true end
            table.insert(active,e)
        end
    end
    for i in pairs(controlled) do
        local n=model.nodes[i];n.transform=CFrame.identity
        n.c0=BodyMath.limit(n.c0,n.rest or n.c0,n.limit)
    end
    local startingWorld=BodyMath.worldGetter(model)
    local objectives={}
    for _,e in ipairs(active) do
        local original=startingWorld(e.part)
        local target=original:PointToWorldSpace(e.offset):Lerp(e.target,e.weight)
        local orient
        if e.orientation then orient=rotation(original)*BodyMath.fraction(rotation(original):Inverse()*rotation(e.orientation),e.weight) end
        table.insert(objectives,{source=e,target=target,orientation=orient})
    end
    local function score()
        local world=BodyMath.worldGetter(model)
        local total,maxError,details=0,0,{}
        for _,o in ipairs(objectives) do
            local e=o.source;local actual=world(e.part)
            local distance=(actual:PointToWorldSpace(e.offset)-o.target).Magnitude
            local angular=0
            if o.orientation then local _,a=BodyMath.axisAngle(rotation(actual):Inverse()*o.orientation);angular=a end
            total=total+(distance*distance+.04*angular*angular)*(e.priority or 1)
            maxError=math.max(maxError,distance)
            details[#details+1]={name=e.name,error=distance,gap=(actual:PointToWorldSpace(e.offset)-e.target).Magnitude,angle=math.deg(angular),actual=actual:PointToWorldSpace(e.offset),target=e.target,weight=e.weight}
        end
        return total,maxError,details
    end
    local bestScore=score()
    local best=state(model)
    local history={bestScore}
    local function keepBest()
        local s=score()
        if s<bestScore then bestScore=s;best=state(model) end
    end
    local iterations=math.clamp(options.iterations or 24,1,64)
    local step=math.rad(options.step or 25)
    local executed=0
    for iteration=1,iterations do
        executed=iteration
        for _,o in ipairs(objectives) do
            local e=o.source
            -- Semente analítica evita ficar preso numa cadeia perfeitamente reta.
            if iteration==1 and #e.chain>=2 then
                local world=BodyMath.worldGetter(model)
                local endpoint=world(e.part):PointToWorldSpace(e.offset)
                local last=#e.chain
                while last>1 do
                    local n=model.nodes[e.chain[last]]
                    if (endpoint-(world(n.parent)*n.c0).Position).Magnitude>.0001 then break end
                    last=last-1
                end
                if last>=2 then
                    local a,b=model.nodes[e.chain[last-1]],model.nodes[e.chain[last]]
                    if b.parent==a.child then
                        local pointLocal=world(b.child):PointToObjectSpace(endpoint)
                        local ok,rc,mc=pcall(MotionMath.solveTwoBone,world(a.parent),a.c0,a.c1,b.c0,b.c1,pointLocal,o.target,e.pole or (o.target+Vector3.new(0,0,-4)))
                        if ok then a.c0=BodyMath.limit(rc,a.rest or a.c0,a.limit);b.c0=BodyMath.limit(mc,b.rest or b.c0,b.limit) end
                    end
                end
            end
            for k=#e.chain,1,-1 do
                local index=e.chain[k];local n=model.nodes[index]
                local world=BodyMath.worldGetter(model)
                local parent=world(n.parent);local joint=parent*n.c0
                local from=world(e.part):PointToWorldSpace(e.offset)-joint.Position
                local toward=o.target-joint.Position
                if from.Magnitude>.000001 and toward.Magnitude>.000001 then
                    local rot=MotionMath.rotationBetween(from,toward,e.pole and (e.pole-joint.Position) or Vector3.yAxis)
                    local axis,angle=BodyMath.axisAngle(rot)
                    rot=CFrame.fromAxisAngle(axis,math.min(angle,step)*.8)
                    local candidate=parent:ToObjectSpace(CFrame.new(joint.Position)*rot*rotation(joint))
                    n.c0=BodyMath.limit(candidate,n.rest or n.c0,n.limit)
                end
            end
            if o.orientation then
                local n=model.nodes[e.chain[#e.chain]]
                if n.child==e.part then
                    local parent=BodyMath.worldGetter(model)(n.parent)
                    local desired=rotation(parent):Inverse()*o.orientation*rotation(n.c1)
                    n.c0=BodyMath.limit(CFrame.new(n.c0.Position)*desired,n.rest or n.c0,n.limit)
                end
            end
            keepBest()
        end
        -- Guarda a melhor solução global; evita aceitar oscilação entre contatos.
        restore(model,best);history[#history+1]=bestScore
        local _,error=score()
        if error<=(options.tolerance or .01) then
            local orientationOK=true
            local _,_,details=score()
            for _,d in ipairs(details) do if d.angle>1 then orientationOK=false end end
            if orientationOK then break end
        end
    end
    restore(model,best)
    local s,error,details=score()
    return {score=s,error=error,details=details,iterations=executed,history=history,controlled=controlled}
end
function BodyMath.control(e,t)
    local function read(keys,fallback)
        if keys and #keys>0 then return Snake.evaluate(keys,t) end
        return fallback
    end
    local function v(a) return Vector3.new(table.unpack(a)) end
    local target=read(e.keys,v(e.target))
    local pole=read(e.poles,v(e.pole))
    local rotationValue=read(e.rotations,e.rotation and Snake.unpack(e.rotation) or CFrame.identity)
    local weight=math.clamp(read(e.weights,e.weight or 1),0,1)
    if not e.enabled then weight=0 end
    local contact
    for _,c in ipairs(e.contacts or {}) do if t>=c.start and t<=c.finish then contact=c;break end end
    if contact then
        local fade=contact.fade or 0
        local blend=fade>0 and math.clamp(math.min((t-contact.start)/fade,(contact.finish-t)/fade),0,1) or 1
        blend=blend*blend*(3-2*blend)
        target=v(contact.point)
        if contact.rotation then rotationValue=Snake.unpack(contact.rotation) end
        weight=weight*blend
    elseif e.contactOnly then weight=0 end
    return target,pole,weight,e.orient and rotationValue or nil
end

