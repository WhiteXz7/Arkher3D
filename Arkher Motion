local function installAdvancedTools()
    local A={channel=1,pin=false,baking=false,ghosts=false,trace=false,dirtyGraph=true,lastGraph=0,lastGhost=0,ghostDirty=false,posesIndex=1,ikGizmo="off",cleanupDone=false}
    local motion=pages.Motion
    local subPages={}
    local subButtons={}
    local subActive="IK"
    local function subTab(name)
        subActive=name
        for n,p in pairs(subPages) do p.Visible=n==name end
        for n,b in pairs(subButtons) do b.BackgroundColor3=n==name and C.accent or C.field;b.TextColor3=n==name and C.dark or C.text end
        A.dirtyGraph=true
        if name=="Poses" and A.refreshPoses then A.refreshPoses() end
        if name=="IK" and A.refreshIK then A.refreshIK() end
        if name=="Corpo" and A.body then A.body.refresh() end
    end
    for i,name in ipairs({"Corpo","IK","Curvas","Ghosts","Poses"}) do
        subButtons[name]=button(motion,name,UDim2.new((i-1)/5,0,0,0),UDim2.new(.2,-4,0,32),function() subTab(name) end)
        subPages[name]=scroll(motion,UDim2.fromOffset(0,42),UDim2.new(1,0,1,-42))
    end
    local function content(name,height)
        return frame(subPages[name],UDim2.new(),UDim2.new(1,-7,0,height),C.bg)
    end
    local function finite(text,min,max)
        local n=tonumber(text)
        assert(n and n==n and math.abs(n)<1e9,"Número inválido")
        assert((not min or n>=min) and (not max or n<=max),"Valor fora do intervalo")
        return n
    end
    local function vec(data) return Vector3.new(data[1],data[2],data[3]) end
    local function arr(v) return {v.X,v.Y,v.Z} end
    local function fkPart(part,inbound,overrides,cache,visiting,worldOverrides)
        if cache[part] then return cache[part] end
        visiting=visiting or {}
        if visiting[part] then return part.CFrame end
        visiting[part]=true
        local m=inbound[part]
        local world=worldOverrides and worldOverrides[part]
        if not world and m and m.Part0 and m.Part1 and m.Part0~=m.Part1 then
            local parent=fkPart(m.Part0,inbound,overrides,cache,visiting,worldOverrides)
            local values=overrides[m] or {}
            local c0=values.C0 or m.C0
            local transform=CFrame.identity
            if m:IsA("Motor6D") then transform=values.Transform or (values.C0 and CFrame.identity) or m.Transform end
            world=parent*c0*transform*m.C1:Inverse()
        end
        world=world or part.CFrame
        cache[part]=world;visiting[part]=nil
        return world
    end
    local function collectRig(rig)
        local parts,inbound={},{}
        for _,obj in ipairs(rig:GetDescendants()) do
            if obj:IsA("BasePart") then table.insert(parts,obj) end
            if obj:IsA("JointInstance") and obj.Part0 and obj.Part1 then
                if obj:IsA("Motor6D") or not inbound[obj.Part1] then inbound[obj.Part1]=obj end
            end
        end
        assert(#parts<=180,"Ghost/IK: limite de 180 Parts por rig nesta versão")
        return parts,inbound
    end
    local function sampleRig(rig,t)
        local parts,inbound=collectRig(rig)
        local overrides,worldOverrides,baseWorld={},{},{}
        for _,p in ipairs(parts) do baseWorld[p]=p.CFrame end
        local pivotEntries={}
        for _,tr in ipairs(project.tracks) do
            if #tr.keys>0 then
                local obj=Snake.resolve(tr.target)
                if obj and (obj==rig or obj:IsDescendantOf(rig)) then
                    local v=Snake.evaluate(tr.keys,t)
                    overrides[obj]=overrides[obj] or {};overrides[obj][tr.property]=v
                end
                if obj and tr.property=="Pivot" and (obj==rig or rig:IsDescendantOf(obj)) then
                    table.insert(pivotEntries,{obj=obj,value=Snake.evaluate(tr.keys,t),depth=#tr.target.path})
                end
            end
        end
        table.sort(pivotEntries,function(a,b) return a.depth<b.depth end)
        -- Pivots absolutos: o ultimo pivot ancestral controla a referencia global.
        local delta=CFrame.identity
        for _,entry in ipairs(pivotEntries) do delta=entry.value*entry.obj:GetPivot():Inverse() end
        for _,p in ipairs(parts) do
            if overrides[p] and overrides[p].CFrame then worldOverrides[p]=overrides[p].CFrame
            elseif not inbound[p] then worldOverrides[p]=delta*baseWorld[p] end
        end
        local worlds={}
        for _,p in ipairs(parts) do fkPart(p,inbound,overrides,worlds,{},worldOverrides) end
        return worlds,parts,overrides
    end
    local function currentParentFrame(rig,part)
        local _,inbound=collectRig(rig)
        return fkPart(part,inbound,{}, {},{},nil)
    end
    local function jointRig(joint)
        local p=joint
        while p and p~=Workspace do
            if p:IsA("Model") and (p:FindFirstChildOfClass("Humanoid") or p:FindFirstChildOfClass("AnimationController")) then return p end
            p=p.Parent
        end
        return joint:FindFirstAncestorOfClass("Model")
    end
    local function relativePath(obj,root)
        local path={}
        while obj~=root do
            assert(obj and obj.Parent,"Objeto fora do rig")
            local ordinal=0
            for _,c in ipairs(obj.Parent:GetChildren()) do
                if c.Name==obj.Name and c.ClassName==obj.ClassName then ordinal=ordinal+1 end
                if c==obj then break end
            end
            table.insert(path,1,{name=obj.Name,class=obj.ClassName,index=ordinal})
            obj=obj.Parent
        end
        return path
    end
    local function resolveRelative(root,path,mirror)
        local node=root
        for _,segment in ipairs(path) do
            if not node then return nil end
            local name=mirror and MotionMath.mirrorName(segment.name) or segment.name
            local index,found=0,nil
            for _,child in ipairs(node:GetChildren()) do
                if child.Name==name and child.ClassName==segment.class then
                    index=index+1;if index==(segment.index or 1) then found=child;break end
                end
            end
            node=found
        end
        return node
    end
    local visuals=make("Folder",Workspace,{Name="SnakeEditorVisuals"})
    visuals:SetAttribute("SnakeEditorVisual",true)
    advancedHooks.visualRoot=visuals
    local ghostFolder=make("Folder",visuals,{Name="OnionSkin"})
    local pathFolder=make("Folder",visuals,{Name="MotionPath"})
    local comFolder=make("Folder",visuals,{Name="MassGuide"})
    local ikFolder=make("Folder",visuals,{Name="IKControls"})
    local function worldPart(parent,name,position,size,color,transparency)
        local p=make("Part",parent,{Name=name,Anchored=true,CanCollide=false,CanTouch=false,CanQuery=false,CastShadow=false,Material=Enum.Material.Neon,Color=color or C.accent,Size=size or Vector3.new(.12,.12,.12),CFrame=CFrame.new(position),Transparency=transparency or 0})
        return p
    end
    local function worldLine(parent,a,b,color,width)
        local delta=b-a
        if delta.Magnitude<.00001 then return nil end
        local p=worldPart(parent,"Line",(a+b)/2,Vector3.new(width or .025,width or .025,delta.Magnitude),color,.12)
        p.CFrame=CFrame.lookAt((a+b)/2,b)
        return p
    end
    local function screenLine(parent,a,b,color,width)
        local d=b-a
        if d.Magnitude<.01 then return end
        local f=frame(parent,UDim2.fromOffset((a.X+b.X)/2,(a.Y+b.Y)/2),UDim2.fromOffset(d.Magnitude,width or 2),color)
        f.AnchorPoint=Vector2.new(.5,.5);f.Rotation=math.deg(math.atan2(d.Y,d.X))
        return f
    end

    do
        local panel=content("IK",1000)
        label(panel,"IK • dois segmentos / Motor6D",UDim2.fromOffset(4,0),UDim2.new(1,-8,0,28))
        local info=label(panel,"Selecione um rig R15 ou defina duas juntas conectadas.",UDim2.fromOffset(4,31),UDim2.new(1,-8,0,58),true)
        local manualRoot=nil
        local targetInputs,poleInputs,endInputs={},{},{}
        local pinButton,ikModeButton
        local targetMarker=worldPart(ikFolder,"Target",Vector3.zero,Vector3.new(.32,.32,.32),C.accent,1)
        targetMarker.Shape=Enum.PartType.Ball
        local poleMarker=worldPart(ikFolder,"Pole",Vector3.zero,Vector3.new(.23,.23,.23),Color3.fromRGB(255,184,111),1)
        poleMarker.Shape=Enum.PartType.Ball
        local handles=make("Handles",gui,{Name="SnakeIKMove",Adornee=targetMarker,Style=Enum.HandlesStyle.Movement,Color3=C.accent,Visible=false})
        local dragBase=nil
        local function chain()
            local cfg=project.ik
            assert(cfg,"Configure uma cadeia IK primeiro")
            local root,mid=Snake.resolve(cfg.root),Snake.resolve(cfg.mid)
            assert(root and mid and root:IsA("Motor6D") and mid:IsA("Motor6D"),"Juntas IK não encontradas")
            assert(root.Part0 and root.Part1 and mid.Part0==root.Part1 and mid.Part1,"As duas juntas precisam estar conectadas em sequência")
            local rig=jointRig(root)
            assert(rig and mid:IsDescendantOf(rig),"Juntas precisam pertencer ao mesmo Model")
            return root,mid,rig,cfg
        end
        function A.solveIK(record)
            if A.body and A.body.live then A.body.live=false;A.body.gizmo="off";A.body.refresh() end
            local root,mid,rig,cfg=chain()
            remember(root,"C0");remember(mid,"C0")
            local parent=currentParentFrame(rig,root.Part0)
            local rc,mc,diag=MotionMath.solveTwoBone(parent,root.C0,root.C1,mid.C0,mid.C1,vec(cfg.endpoint),vec(cfg.target),vec(cfg.pole))
            root.Transform=CFrame.identity;mid.Transform=CFrame.identity
            root.C0=rc;mid.C0=mc
            if record then
                local rt,mt=ensureTrack(root,"C0"),ensureTrack(mid,"C0")
                selectedTrack=rt;selectedKey=insertKey(rt,playhead,rc);insertKey(mt,playhead,mc)
                selected=root;selectedProperty="C0"
                refreshTimeline();refreshInspector()
            end
            A.lastIK=diag
            return rc,mc,diag
        end
        local function bind(root,mid,endpoint)
            assert(root and mid and root:IsA("Motor6D") and mid:IsA("Motor6D"),"Selecione duas Motor6Ds")
            assert(root.Part0 and root.Part1 and mid.Part0==root.Part1 and mid.Part1,"A Part1 da raiz deve ser a Part0 da junta do meio")
            local rig=jointRig(root);assert(rig,"Rig não encontrado")
            endpoint=endpoint or Vector3.new(0,-mid.Part1.Size.Y/2,0)
            for _,obj in ipairs(rig:GetDescendants()) do
                if obj:IsA("Motor6D") and obj.Part0==mid.Part1 then endpoint=obj.C0.Position;break end
            end
            local parent=currentParentFrame(rig,root.Part0)
            local rw=parent*root.C0
            local mw=rw*root.C1:Inverse()*mid.C0
            local endWorld=(mw*mid.C1:Inverse()):PointToWorldSpace(endpoint)
            local direction=endWorld-rw.Position
