            draggingKey.key.t=t;draggingKey.dot.Position=UDim2.new(0,t*pixelsPerSecond-10,draggingKey.dot.Position.Y.Scale,draggingKey.dot.Position.Y.Offset)
            table.sort(draggingKey.track.keys,function(a,b) return a.t<b.t end)
