function Snake.validate(project)
    assert(type(project)=="table" and (project.version==1 or project.version==2 or project.version==3),"Versao de projeto invalida")
    assert(type(project.duration)=="number" and project.duration>0 and project.duration<=600,"Duracao: 0.01 a 600 segundos")
    assert(type(project.tracks)=="table" and #project.tracks<=512,"Limite: 512 faixas")
    local count=0
    for _,track in ipairs(project.tracks) do
        assert(type(track.target)=="table" and type(track.target.path)=="table","Alvo invalido")
        track.label=tostring(track.label or track.property or "Faixa")
        assert(Snake.allowed[track.property],"Propriedade nao permitida")
        assert(type(track.keys)=="table","Keyframes invalidos")
        for _,key in ipairs(track.keys) do
            assert(type(key.t)=="number" and key.t==key.t and key.t>=0 and key.t<=project.duration,"Tempo de keyframe invalido")
            if key.bezier then
                assert(type(key.bezier)=="table" and #key.bezier==4,"Bezier precisa de 4 controles")
                for _,v in ipairs(key.bezier) do assert(type(v)=="number" and v>=0 and v<=1,"Controles Bezier: 0 a 1") end
            end
            local value=Snake.unpack(key.value)
            if typeof(value)=="number" then assert(value==value and math.abs(value)<1e12,"Numero invalido") end
            count=count+1
            assert(count<=30000,"Limite: 30.000 keyframes")
        end
        table.sort(track.keys,function(a,b) return a.t<b.t end)
        for i=2,#track.keys do assert(track.keys[i].t-track.keys[i-1].t>0.000001,"Keyframes sobrepostos") end
    end
    if project.poses then
        assert(type(project.poses)=="table" and #project.poses<=50,"Biblioteca: limite de 50 poses")
        for _,pose in ipairs(project.poses) do
            assert(type(pose.name)=="string" and #pose.name<=80 and type(pose.entries)=="table" and #pose.entries<=512,"Pose invalida")
            for _,entry in ipairs(pose.entries) do
                assert(type(entry.path)=="table" and #entry.path<=64,"Caminho de pose invalido")
                for _,seg in ipairs(entry.path) do assert(type(seg.name)=="string" and type(seg.class)=="string","Segmento invalido") end
                assert(entry.property=="C0" or entry.property=="Transform","Propriedade de pose invalida")
                assert(entry.value and entry.value.kind=="CFrame","Pose precisa conter CFrame")
                Snake.unpack(entry.value)
            end
        end
    end
    if project.ik then
        local ik=project.ik
        assert(type(ik)=="table" and type(ik.root)=="table" and type(ik.mid)=="table","Configuracao IK invalida")
        assert(type(ik.root.path)=="table" and type(ik.mid.path)=="table","Alvos IK invalidos")
        for _,name in ipairs({"endpoint","target","pole"}) do
            local v=ik[name]
            assert(type(v)=="table" and #v==3,"Vetor IK invalido")
            for _,n in ipairs(v) do assert(type(n)=="number" and n==n and math.abs(n)<1e9,"Numero IK invalido") end
        end
    end
    Snake.validateBody(project.body,project.duration)
    return project
end
function Snake.compile(project)
    local compiled={}
    for _,track in ipairs(project.tracks) do
