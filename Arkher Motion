local function moveKeyToTime(tr,key,t)
    for i=#tr.keys,1,-1 do
        local k=tr.keys[i]
        if k~=key and math.abs(k.t-t)<.000001 then table.remove(tr.keys,i) end
    end
    key.t=t;table.sort(tr.keys,function(a,b) return a.t<b.t end)
