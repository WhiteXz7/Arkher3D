connect(UserInputService.InputBegan,safe(function(input,processed)
    if processed or UserInputService:GetFocusedTextBox() then return end
    if pickInWorld and (input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch) then
        local cam=Workspace.CurrentCamera
        local ray=cam:ScreenPointToRay(input.Position.X,input.Position.Y)
        local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances={selectionBox}
        local hit=Workspace:Raycast(ray.Origin,ray.Direction*3000,params)
        if hit then selectObject(hit.Instance);pickInWorld=false;pickButton.Text="Selecionar no mundo";window.Visible=true end
        return
    end
    if input.KeyCode==Enum.KeyCode.Escape then pickInWorld=false;window.Visible=true;pickButton.Text="Selecionar no mundo";releaseCamera();return end
    if not window.Visible then return end
    local ctrl=UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
    if ctrl and input.KeyCode==Enum.KeyCode.Z then history(false)
    elseif ctrl and input.KeyCode==Enum.KeyCode.Y then history(true)
    elseif input.KeyCode==Enum.KeyCode.Space then playPause()
    elseif input.KeyCode==Enum.KeyCode.K then keyCurrent()
    elseif input.KeyCode==Enum.KeyCode.Delete then deleteKey()
    elseif input.KeyCode==Enum.KeyCode.Left then stopPreview(false);previewAt(snap(playhead-1/project.fps),true);refreshTimeline()
    elseif input.KeyCode==Enum.KeyCode.Right then stopPreview(false);previewAt(snap(playhead+1/project.fps),true);refreshTimeline() end
end))
