local function readFields()
    assert(fieldKind,"Nenhuma propriedade selecionada")
    local a={}
    for i,b in ipairs(fieldInputs) do
        if fieldKind=="string" or fieldKind=="boolean" then a[i]=b.Text
        else a[i]=tonumber(b.Text);assert(a[i] and a[i]==a[i] and math.abs(a[i])<1e9,"Número inválido no campo "..i) end
    end
    if fieldKind=="CFrame" then return CFrame.new(a[1],a[2],a[3])*CFrame.fromOrientation(math.rad(a[4]),math.rad(a[5]),math.rad(a[6])) end
    if fieldKind=="UDim2" then return UDim2.new(a[1],a[2],a[3],a[4]) end
    if fieldKind=="UDim" then return UDim.new(a[1],a[2]) end
    if fieldKind=="Vector3" then return Vector3.new(a[1],a[2],a[3]) end
    if fieldKind=="Vector2" then return Vector2.new(a[1],a[2]) end
    local function color(offset) return Color3.fromRGB(math.clamp(a[offset],0,255),math.clamp(a[offset+1],0,255),math.clamp(a[offset+2],0,255)) end
    if fieldKind=="Color3" then return color(1) end
    if fieldKind=="NumberRange" then assert(a[2]>=a[1],"Máximo menor que mínimo");return NumberRange.new(a[1],a[2]) end
    if fieldKind=="NumberSequence" then return NumberSequence.new(a[1],a[2]) end
    if fieldKind=="ColorSequence" then return ColorSequence.new(color(1),color(4)) end
    if fieldKind=="boolean" then assert(a[1]=="true" or a[1]=="false","Use true ou false");return a[1]=="true" end
    return a[1]
end
