            local e=eff();local channel=B.gizmo=="pole" and "poles" or "keys"
            if #e[channel]==0 and playhead>0 then customKey(e[channel],0,B.gizmo=="pole" and vec(e.pole) or vec(e.target)) end
            customKey(e[channel],playhead,baseDrag+Vector3.FromNormalId(face)*distance)
            B.solve(playhead,true);B.refreshFields()
        end))
        connect(handles.MouseButton1Up,function() baseDrag=nil;B.refresh() end)
        function B.update()
            local body=project.body;local e=body and body.effectors[B.selected]
            local visible=e and (B.gizmo~="off" or (activePage=="Motion" and subActive=="Corpo" and window.Visible))
            goalMarker.Transparency=visible and .1 or 1;poleMarker.Transparency=visible and .2 or 1;actualMarker.Transparency=visible and .2 or 1
            handles.Visible=e~=nil and B.gizmo~="off" and not playing and not A.baking
            handles.Adornee=B.gizmo=="pole" and poleMarker or goalMarker
            gizmoSelect.Text="Gizmo Body: "..B.gizmo
            if e and visible then
                local target,pole=BodyMath.control(e,playhead);goalMarker.CFrame=CFrame.new(target);poleMarker.CFrame=CFrame.new(pole)
                local tip=Snake.resolve(e.tip);local rig=Snake.resolve(body.rig)
                if tip and rig then actualMarker.CFrame=CFrame.new(currentParentFrame(rig,tip):PointToWorldSpace(vec(e.offset))) end
            end
            if os.clock()-B.lastUpdate>.25 then
                B.lastUpdate=os.clock()
                if B.result then
                    local lines={string.format("%d iterações • erro máx %.4f studs",B.result.iterations,B.result.error)}
                    for _,d in ipairs(B.result.details) do lines[#lines+1]=string.format("%s: erro %.3f | gap %.3f | %.1f° | peso %.2f",d.name,d.error,d.gap,d.angle,d.weight) end
                    diagnostic.Text=table.concat(lines,"\n")
                end
            end
        end
        B.refresh()
    end

    advancedHooks.previewStopped=function(restore)
        if restore then A.pin=false;A.refreshIK();if A.body then A.body.live=false;A.body.refresh() end end
    end
    advancedHooks.tracksChanged=function()
        A.dirtyGraph=true;A.ghostDirty=true
    end
    advancedHooks.timeChanged=function(updateFields)
        if A.pin and project.ik and not A.baking then
            local ok,err=pcall(A.solveIK,false)
            if not ok then A.pin=false;A.refreshIK();notify(tostring(err),true) end
        end
        if A.body and A.body.live and not A.baking and not A.pin then
            local ok,err=pcall(A.body.solve,playhead,true)
            if not ok then A.body.live=false;notify(tostring(err),true) end
        end
        if updateFields then A.dirtyGraph=true;A.ghostDirty=true;if A.body then A.body.refreshFields() end end
    end
    advancedHooks.projectChanged=function()
        A.pin=false;A.graphRange=nil;A.dirtyGraph=true;A.posesIndex=1
        A.clearMotionViews();A.refreshIK();A.refreshPoses()
        if A.body then A.body.live=false;A.body.gizmo="off";A.body.result=nil;A.body.refresh() end
    end
    advancedHooks.cleanup=function()
        if A.cleanupDone then return end
        A.cleanupDone=true;A.pin=false;A.ikGizmo="off"
        if A.body then A.body.live=false;A.body.gizmo="off" end
        if visuals.Parent then visuals:Destroy() end
    end
    connect(RunService.RenderStepped,function()
        if not alive or A.cleanupDone then return end
        A.updateIKMarkers()
        if A.body then
            if A.pin and A.body.live then A.body.live=false;A.body.refresh() end
            if A.body.live and not playing and not A.baking then
                local ok,err=pcall(A.body.solve,playhead,true)
                if not ok then A.body.live=false;notify(tostring(err),true) end
            end
            local ok,err=pcall(A.body.update)
            if not ok and not A.body.warned then A.body.warned=true;notify(tostring(err),true) end
        end
        if A.pin and not playing and not A.baking and project.ik then
            local ok,err=pcall(A.solveIK,false)
            if not ok then A.pin=false;A.refreshIK();notify(tostring(err),true) end
        end
        if A.dirtyGraph and not A.baking and activePage=="Motion" and subActive=="Curvas" and window.Visible and os.clock()-A.lastGraph>.05 then
            A.lastGraph=os.clock()
            local ok,err=pcall(A.drawGraphs)
            if not ok then A.dirtyGraph=false;notify("Gráfico: "..tostring(err),true) end
        end
        if A.ghosts and A.ghostDirty and not playing and not A.baking and os.clock()-A.lastGhost>.5 then
            local ok,err=pcall(A.rebuildGhosts)
            if not ok then A.ghostDirty=false;A.ghosts=false;notify("Ghosts: "..tostring(err),true) end
        end
    end)
    advancedHooks.retime=function(ratio)
        local body=project.body;if not body then return end
        for _,e in ipairs(body.effectors) do
            for _,channel in ipairs({"keys","poles","rotations","weights"}) do for _,k in ipairs(e[channel]) do k.t=k.t*ratio end end
            for _,c in ipairs(e.contacts) do c.start=c.start*ratio;c.finish=c.finish*ratio;c.fade=c.fade*ratio end
        end
        for _,src in ipairs(body.sources or {}) do for _,k in ipairs(src.keys) do k.t=k.t*ratio end end
    end
    subTab("Corpo")
end
