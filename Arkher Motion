-- Derivada de translação de um segmento Hermite explícito. Usada para subdividir
-- uma trajetória balística anterior sem convertê-la em cordas lineares.
function PhysicsMath.curveVelocity(keys,t,left)
    for i=1,#keys-1 do
        local a,b=keys[i],keys[i+1]
        local inside=left and t>a.t+1e-8 and t<=b.t+1e-8 or (not left and t>=a.t-1e-8 and t<b.t-1e-8)
        if inside then
            if a.ease~="hermite" then return nil end
            local va,vb=Snake.unpack(a.value),Snake.unpack(b.value)
            local p0,p1=typeof(va)=="CFrame" and va.Position or va,typeof(vb)=="CFrame" and vb.Position or vb
            local dt=b.t-a.t;local u=math.clamp((t-a.t)/dt,0,1)
            local slope=(p1-p0)/dt
            local m0=a.outTangent and Snake.unpack(a.outTangent) or slope
            local m1=b.inTangent and Snake.unpack(b.inTangent) or slope
            return (p0*(6*u*u-6*u)+p1*(-6*u*u+6*u))/dt+m0*(3*u*u-4*u+1)+m1*(3*u*u-2*u),i
        end
    end
end

-- Transformações puras usadas pelos gizmos V5. Todos os deltas partem do início do gesto.
local TransformMath={}
function TransformMath.snap(n,step)
    if not step or step<=0 then return n end
    return math.floor(n/step+.5)*step
end
function TransformMath.axis(index) return index==1 and Vector3.xAxis or index==2 and Vector3.yAxis or Vector3.zAxis end
function TransformMath.component(v,index) return index==1 and v.X or index==2 and v.Y or v.Z end
function TransformMath.size(base,index,distance,uniform,minimum,maximum)
    minimum,maximum=minimum or .001,maximum or 2048
    local a={base.X,base.Y,base.Z}
    if uniform then
        local factor=1+distance/math.max(base.X,base.Y,base.Z,.001)
        local low=math.max(minimum/base.X,minimum/base.Y,minimum/base.Z)
        local high=math.min(maximum/base.X,maximum/base.Y,maximum/base.Z)
        factor=math.clamp(factor,low,high)
        return base*factor
    end
    a[index]=math.clamp(a[index]+distance,minimum,maximum)
    return Vector3.new(table.unpack(a))
end
function TransformMath.pose(baseWorld,index,amount,mode,space)
    local axis=TransformMath.axis(index)
    if space=="local" then axis=baseWorld:VectorToWorldSpace(axis) end
    if mode=="move" then return baseWorld+axis*amount end
    return CFrame.new(baseWorld.Position)*CFrame.fromAxisAngle(axis,amount)*(baseWorld-baseWorld.Position)
end
function TransformMath.faceCenter(cf,base,newSize,index,sign)
    return cf+cf:VectorToWorldSpace(TransformMath.axis(index))*((TransformMath.component(newSize,index)-TransformMath.component(base,index))*sign/2)
end
function TransformMath.scaledTranslation(cf,ratio) return cf+cf.Position*(ratio-1) end
function TransformMath.projectedDelta(start,finish,axisPixels,studs)
    local dx,dy=axisPixels.X,axisPixels.Y
    local length2=dx*dx+dy*dy
    if length2<16 then return nil end
    return ((finish.X-start.X)*dx+(finish.Y-start.Y)*dy)/length2*studs
end
function TransformMath.tap(first,last,duration,multitouch)
    local dx,dy=last.X-first.X,last.Y-first.Y
    return not multitouch and duration<=.65 and dx*dx+dy*dy<=100
end

