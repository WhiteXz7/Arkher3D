    function S.revealFocus()
        local focus=UserInputService:GetFocusedTextBox()
        local keyboard=UserInputService.OnScreenKeyboardVisible
        if S.padding and (not keyboard or focus~=S.lastFocus) then
            if S.padding.object.Parent then S.padding.object.CanvasSize=S.padding.size end
            S.padding=nil
        end
        if not keyboard or not focus or not focus:IsDescendantOf(gui) then S.lastFocus=nil;return end
        local position=UserInputService.OnScreenKeyboardPosition
        if S.lastFocus==focus and S.keyboardY==(position and position.Y) then return end
        S.lastFocus=focus;S.keyboardY=position and position.Y
        if not position or position.Y<=0 or focus.Size.Y.Scale~=0 or focus.Size.Y.Offset>150 then return end
        local parent=focus.Parent
        while parent and parent~=gui and not parent:IsA("ScrollingFrame") do parent=parent.Parent end
        if not parent or not parent:IsA("ScrollingFrame") then return end
        local delta=focus.AbsolutePosition.Y+focus.AbsoluteSize.Y-(position.Y-20)
        if delta>0 then
            S.padding={object=parent,size=parent.CanvasSize}
            local actual=parent.AbsoluteCanvasSize and parent.AbsoluteCanvasSize.Y or parent.CanvasSize.Y.Offset
            parent.CanvasSize=UDim2.new(parent.CanvasSize.X.Scale,parent.CanvasSize.X.Offset,0,actual+delta+60)
            parent.CanvasPosition=Vector2.new(parent.CanvasPosition.X,parent.CanvasPosition.Y+delta)
        end
    end
