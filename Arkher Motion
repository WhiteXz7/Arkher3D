        local function issue(text) result.issues[#result.issues+1]=text end
        for _,o in ipairs(model:GetDescendants()) do
            if o:IsA("BasePart") then result.parts=result.parts+1 end
            if o:IsA("Motor6D") then
                if not o.Part0 or not o.Part1 or o.Part0==o.Part1 or not o.Part0:IsDescendantOf(model) or not o.Part1:IsDescendantOf(model) then issue("Motor inválido / fora do Model: "..o.Name)
                else
                    result.channels[#result.channels+1]={object=o,property="C0",part=o.Part1}
                    if incoming[o.Part1] then issue("Mais de um Motor6D controla "..o.Part1.Name) end
                    incoming[o.Part1]=o;vertices[o.Part0]=true;vertices[o.Part1]=true
                    graph[o.Part0]=graph[o.Part0] or {};graph[o.Part1]=graph[o.Part1] or {}
                    table.insert(graph[o.Part0],o.Part1);table.insert(graph[o.Part1],o.Part0)
                    if o.Part1.Anchored then issue("Membro ancorado pode impedir a junta: "..o.Part1.Name) end
                end
            elseif o:IsA("Bone") then result.channels[#result.channels+1]={object=o,property="Transform",part=o} end
        end
        local visited={}
        for part in pairs(vertices) do if not visited[part] then
            result.components=result.components+1;local stack={part};visited[part]=true
            while #stack>0 do local p=table.remove(stack);for _,q in ipairs(graph[p] or {}) do if not visited[q] then visited[q]=true;stack[#stack+1]=q end end end
        end end
        local cycle=false
        for part in pairs(incoming) do
            local chain={};local p=part
            while incoming[p] do if chain[p] then cycle=true;break end;chain[p]=true;p=incoming[p].Part0 end
        end
        if cycle then issue("Ciclo de Motor6D: revise a hierarquia antes de animar") end
        if result.components>1 then issue(result.components.." grupos de Motor6D sem ligação entre si") end
        for _,o in ipairs(model:GetDescendants()) do if o:IsA("BasePart") and not vertices[o] and not o:FindFirstChildWhichIsA("Bone",true) then result.loose=result.loose+1 end end
        if result.loose>0 then issue(result.loose.." Parts sem participação na cadeia Motor6D (podem ser acessórios soldados ou peças soltas)") end
        if #result.channels==0 then issue("Sem Motor6D/Bone animável. Um Model de Parts não é automaticamente um rig") end
        table.sort(result.channels,function(a,b) return a.object:GetFullName()<b.object:GetFullName() end)
        return result
    end
