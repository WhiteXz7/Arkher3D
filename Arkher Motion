    if kind=="UDim" then return UDim.new(a.Scale+(b.Scale-a.Scale)*u,a.Offset+(b.Offset-a.Offset)*u) end
    if kind=="CFrame" or kind=="Vector3" or kind=="Vector2" or kind=="Color3" then return a:Lerp(b,u) end
    if kind=="NumberRange" then return NumberRange.new(a.Min+(b.Min-a.Min)*u,a.Max+(b.Max-a.Max)*u) end
