        local t=length2>1e-12 and math.clamp(((p.X-a.X)*dx+(p.Y-a.Y)*dy)/length2,0,1) or 0
        local q=Vector2.new(a.X+dx*t,a.Y+dy*t);local d=dist2(p,q)
