local function installRigWorkspace()
    local R={model=nil,protect=true,exportMode="scene",clipboard=nil};V5.rig=R
    function R.find(obj)
        local node=obj;local candidate
        while node and node~=Workspace do
            if node:IsA("Model") then
                if node:FindFirstChildOfClass("Humanoid") or node:FindFirstChildOfClass("AnimationController") then return node end
                if node:FindFirstChildWhichIsA("Motor6D",true) or node:FindFirstChildWhichIsA("Bone",true) then candidate=candidate or node end
            end
