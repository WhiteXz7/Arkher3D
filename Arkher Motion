-- Cache separado do projeto: evita reconstruir valores Roblox a cada frame.
local decodedValues=setmetatable({}, {__mode="k"})
local function decoded(key)
    local cached=decodedValues[key]
    if cached and cached.source==key.value then return cached.value end
    local v=Snake.unpack(key.value)
    decodedValues[key]={source=key.value,value=v}
    return v
end
function Snake.evaluate(keys,t)
    local n=#keys
    if n==0 then return nil end
    if t<=keys[1].t then return decoded(keys[1]) end
    if t>=keys[n].t then return decoded(keys[n]) end
    local lo,hi=1,n
    while hi-lo>1 do
        local mid=math.floor((lo+hi)/2)
        if keys[mid].t<=t then lo=mid else hi=mid end
    end
    local a,b=keys[lo],keys[hi]
    local dt=math.max(0.000001,b.t-a.t)
    local u=(t-a.t)/dt
    local va,vb=decoded(a),decoded(b)
    if a.ease=="cubic" and (typeof(va)=="number" or typeof(va)=="Vector3" or typeof(va)=="CFrame") then
        local prev,nextKey=keys[math.max(1,lo-1)],keys[math.min(n,hi+1)]
        local vp,vn=decoded(prev),decoded(nextKey)
        local isCF=typeof(va)=="CFrame"
        local p0,p1,pp,pn=va,vb,vp,vn
        if isCF then p0,p1,pp,pn=va.Position,vb.Position,vp.Position,vn.Position end
        local m0=(p1-pp)/math.max(0.000001,b.t-prev.t)
        local m1=(pn-p0)/math.max(0.000001,nextKey.t-a.t)
