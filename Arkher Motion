            if i>1 then assert(k.t-list[i-1].t>.000001,"Chaves Body sobrepostas") end
            if k.bezier then assert(#k.bezier==4,"Bézier Body inválida");for _,n in ipairs(k.bezier) do number(n,0,1) end end
