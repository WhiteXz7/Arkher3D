-- pós-pass: texturas PBR procedurais (o diferencial visual) por cima
-- das parts/meshes que o motor R3D2 criou. Vidro/neon/plástico ficam puros.
local function postTextures(model, status)
    local total = 0
    for _, inst in ipairs(model:GetDescendants()) do
        if inst:IsA("BasePart") then total = total + 1 end
    end
    local done = 0
    for _, inst in ipairs(model:GetDescendants()) do
        if inst:IsA("BasePart") then
            local key = MAT_TO_TEX[inst.Material]
            if key then
                local r, g, b = inst.Color:ToRGB()
                applyLook(inst, key, {r, g, b})
            end
            done = done + 1
            if done % 60 == 0 or done == total then
                status(string.format("texturizando… %d/%d", done, total))
                task.wait()
            end
        end
    end
end

-- build v2: specs do expandOps → R3D2.build (parts + meshes reais +
-- fusão booleana + extras + mood) → texturas PBR → posiciona na frente
local function buildScene(specs, atPosition, status)
    local name = tostring(specs.name or "modelo"):gsub("[^%a%d_]+", "_"):sub(1, 40)
    if name == "" then name = "modelo" end
    local model, stats = R3D2.build(specs, workspace, { capabilities = CAPS, nome = "Roblox3D_" .. name }, status)
    if not model then return nil, nil end
    model:SetAttribute("Roblox3D", true)
    local first = model:FindFirstChildWhichIsA("BasePart")
    if first then pcall(function() model.PrimaryPart = first end) end
    postTextures(model, status)
    if atPosition then
        pcall(function() model:PivotTo(atPosition) end)
    end
    return model, stats
end
local function playerAnchor()
    local player = Players.LocalPlayer
    local char = player and player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return Vector3.new(0, 0, 0), 0 end
    local forward = hrp.CFrame.LookVector
    forward = Vector3.new(forward.X, 0, forward.Z)
    if forward.Magnitude < 0.1 then forward = Vector3.new(0, 0, -1) end
    forward = forward.Unit
    local pos = hrp.Position + forward * 20
    pos = Vector3.new(pos.X, hrp.Position.Y - 3, pos.Z)
    local yaw = math.atan2(forward.X, forward.Z) * 180 / math.pi
    return pos, yaw
end

