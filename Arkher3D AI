local texAPI = nil
local textureCache = {}

local function probeTextureAPI()
    local okNew, t = pcall(function()
        local c = Instance.new("CanvasTexture")
        c.CanvasSize = Vector2.new(16, 16)
        return c
    end)
    if not okNew or not t then return nil end
    local okCtx, ctx = pcall(function() return t:GetGraphicsContext() end)
    if not okCtx or not ctx then return nil end
    local okSet = pcall(function() ctx:SetPixel(0, 0, Color3.new(1, 1, 1)) end)
    if okSet then
        return function()
            local c = Instance.new("CanvasTexture")
            c.CanvasSize = Vector2.new(TEX_SIZE, TEX_SIZE)
            return c, c:GetGraphicsContext(), "setpixel"
        end
    end
    local okFill = pcall(function() ctx:FillRectangle(0, 0, 1, 1, Color3.new(1, 1, 1)) end)
    if okFill then
        return function()
            local c = Instance.new("CanvasTexture")
            c.CanvasSize = Vector2.new(TEX_SIZE, TEX_SIZE)
            return c, c:GetGraphicsContext(), "fillrect"
        end
    end
    return nil
end

local function getTexture(key, def)
    if textureCache[key] then return textureCache[key] end
    if not texAPI then return nil end
    local ok, canvas = pcall(function()
        local c, ctx, mode = texAPI()
        local styleKey = TEX_STYLE_KEY[key] or def.style
        local sampler = samplers[styleKey]
        local b, seed = def.base, def.s
        for y = 0, TEX_SIZE - 1 do
            for x = 0, TEX_SIZE - 1 do
                local u, v = x / TEX_SIZE, y / TEX_SIZE
                local r, g, bl = sampler(u, v, b, seed)
                local col = Color3.new(math.clamp(r, 0, 255) / 255, math.clamp(g, 0, 255) / 255, math.clamp(bl, 0, 255) / 255)
                if mode == "setpixel" then
                    ctx:SetPixel(x, y, col)
                else
                    ctx:FillRectangle(x, y, 1, 1, col)
                end
            end
            if (y % 32) == 31 then task.wait() end
        end
        return c
    end)
    if ok and canvas then textureCache[key] = canvas end
    return textureCache[key]
end

local function safeMat(name)
    local ok, v = pcall(function() return Enum.Material[name] end)
    return (ok and v) or Enum.Material.SmoothPlastic
end

local function applyLook(part, texKey, rgb)
    local col = Color3.new(rgb[1] / 255, rgb[2] / 255, rgb[3] / 255)
    local def = TEX_DEFS[texKey]
    local done = false
    if def and texAPI then
        done = pcall(function()
            local canvas = getTexture(texKey, def)
            if not canvas then error("sem textura") end
            local variant = Instance.new("MaterialVariant")
            variant.BaseColor = col
            local mt = Instance.new("MaterialTexture")
            mt.Texture = canvas
            mt.Tiled = true
            mt.ScaleU = 1.6
            mt.ScaleV = 1.6
            local sa = Instance.new("SurfaceAppearance")
            sa.Material = variant
            sa.MainTexture = mt
            part.SurfaceAppearance = sa
        end)
    end
    if not done then
        local matName
        if MAT_PURE[texKey] then
            matName = MAT_PURE[texKey]
        else
            matName = MAT_FALLBACK[texKey] or "SmoothPlastic"
        end
        part.Material = safeMat(matName)
        part.Color = col
    end
end

