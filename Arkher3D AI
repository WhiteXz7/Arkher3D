OPS.caixa = OPS.box
OPS.parede = OPS.wall
OPS.escada = OPS.stair
OPS.porta = OPS.door
OPS.fachada = OPS.window
OPS.arvore = OPS.tree
OPS.pedra = OPS.rock
OPS.luz = OPS.light
OPS.particula = OPS.particle
OPS.feixe = OPS.beam
OPS.coluna = OPS.column

local extraOps = { light = true, particula = true, particle = true, feixe = true, beam = true, placa = true, tela = true, decal = true, mood = true }

function R3D2.expandOps(scene, opts)
  opts = opts or {}
  local ctx = {
    parts = {}, smooths = {}, extras = {},
    stats = { parts = 0, truncated = false, triEm = 0, ops = 0, skipped = 0 },
    budget = math.floor(opts.budget or 3000),
    emOk = opts.emOk or false,
  }
  if type(scene) ~= "table" then
    return nil, "scene não é uma tabela"
  end
  -- ops[] (v2) + partes[] (v1 legacy)
  local function opType(op)
    -- só aceita STRING (se a IA escrevesse t:0.5, o "t" da parede seria nº)
    for _, k in ipairs({ "t", "tipo", "type" }) do
      local v = op[k]
      if type(v) == "string" then return v:lower() end
    end
    return nil
  end
  local function handle(arr)
    for _, op in ipairs(arr or {}) do
      if type(op) == "table" and ctx.stats.ops < 1200 then
        local t = opType(op)
        -- recuperação: se a IA usou "t" p/ espessura (número), o tipo se perdeu;
        -- from+to+openings/h só faz sentido p/ parede
        if t == nil and op.from and op.to and (op.openings or op.h) then
          t = "wall"
        end
        if t == "part" or (type(op.kind) == "string" and t == nil) then
          -- formato v1: {kind, pos, size, mat, color, rot}
          partSpec(ctx, {
            pos = op.pos, size = op.size,
            rot = op.rot, shape = nil,
            mat = op.mat or op.material, cor = op.color or op.cor,
          })
        else
          local key = type(t) == "string" and t:lower():gsub("%s+", "_") or nil
          local h = OPS[key]
          if h then
            if extraOps[key] and #ctx.extras >= 60 then
              ctx.stats.skipped = ctx.stats.skipped + 1
            else
              ctx.stats.ops = ctx.stats.ops + 1
              local ok = pcall(h, op, ctx)
              if not ok then ctx.stats.skipped = ctx.stats.skipped + 1 end
            end
          else
            ctx.stats.skipped = ctx.stats.skipped + 1
          end
        end
      end
    end
  end
  -- formato v1 antigo (AllInOne 1.x): parts = [["box", size, pos, rot, mat, cor, nome], ...]
  -- legado = barato: sphere/box viram 1 part (shape Ball), cylinder vira cyl compacto
  local v1 = {}
  for _, row in ipairs(scene.parts or {}) do
    if type(row) == "table" and #row >= 5 and type(row[1]) == "string"
      and type(row[2]) == "table" and type(row[3]) == "table" then
      local kind = row[1]:lower()
      if kind == "cylinder" or kind == "cilindro" then
        v1[#v1 + 1] = { t = "cyl", pos = row[3], r = row[2][1], h = row[2][2] or row[2][1],
          segs = 12, mat = row[5], cor = row[6], rotY = row[4] and row[4][2] or 0 }
      elseif kind == "sphere" or kind == "esfera" then
        local r = row[2][1] or 1
        partSpec(ctx, { pos = row[3], size = { r * 2, r * 2, r * 2 }, rot = row[4],
          shape = "ball", mat = row[5], cor = row[6] })
      else
        partSpec(ctx, { pos = row[3], size = row[2], rot = row[4], mat = row[5], cor = row[6] })
      end
    end
  end
  handle(scene.ops)
  handle(scene.partes)  -- v1 legacy (client/server)
  handle(v1)            -- v1 array (AllInOne 1.x)
  return { parts = ctx.parts, smooths = ctx.smooths, extras = ctx.extras, mood = ctx.mood, stats = ctx.stats }, nil
end

-- ---------------- normalização de entrada (v1 + v2) ----------------
function R3D2.normalizeScene(data)
  if type(data) ~= "table" then return nil, "JSON inválido" end
  return data, nil
end

-- ============================================================
-- BUILD (somente Roblox)
-- ============================================================
local function hasRoblox()
  return type(Instance) == "table" and type(game) == "table" and game ~= nil
end

function R3D2.probe()
  -- detecta capacidades de mesh em runtime (tudo pcall: falha = sem a feature)
  local cap = { union = false, sweep = false, emesh = false }
  if not hasRoblox() then return cap end
  pcall(function()
    local GS = game:GetService("GeometryService")
    local p1 = Instance.new("Part"); p1.Size = Vector3.new(2, 2, 2)
    local p2 = Instance.new("Part"); p2.Size = Vector3.new(2, 2, 2); p2.CFrame = CFrame.new(1.5, 0, 0)
    local ok, res = pcall(function()
      return GS:UnionAsync(p1, { p2 }, { CollisionFidelity = Enum.CollisionFidelity.Hull })
    end)
    p1:Destroy(); p2:Destroy()
    if ok and type(res) == "table" then
      for _, r in ipairs(res) do pcall(function() r:Destroy() end) end
      cap.union = true
    end
  end)
  pcall(function()
    if type(game:GetService("GeometryService").SweepPartAsync) == "function" then cap.sweep = true end
  end)
  pcall(function()
    local em = game:GetService("AssetService"):CreateEditableMesh()
    if em and type(em.AddVertex) == "function" then cap.emesh = true end
  end)
  return cap
end

local function makeColor(cor)
  if not cor then return nil end
  local r, g, b = R3D2.hexToRgb(cor)
  if r then
    if hasRoblox() then return Color3.fromRGB(r, g, b) end
    return { r, g, b }
  end
  return nil
end

function R3D2.build(specs, parent, opts, onProgress)
  if not hasRoblox() then
    return nil, "build() só roda no Roblox"
  end
  opts = opts or {}
  local cap = opts.capabilities or R3D2.probe()
  local WS = game:GetService("Workspace")
  local GS = game:GetService("GeometryService")
  local AS = game:GetService("AssetService")
  local nome = opts.nome or "Modelo"
  local model = Instance.new("Model")
  model.Name = nome
  model.Parent = nil

  local stats = { parts = 0, meshes = 0, tris = 0, merged = 0, em = 0 }
  local function prog(msg) if onProgress then pcall(onProgress, msg, stats) end end
  prog("criando model...")

  local function matOf(spec)
    local m = R3D2.matName(spec.mat)
    local col = makeColor(spec.cor)
    return m, col
  end

  -- 1) parts (fallbacks de ops smooth ficam RETIDOS sem parent)
  local groupParts = {}
  local heldFb = {}   -- smoothId → list of {p=part, sp=spec, done=bool}
  local function placePart(p, sp)
    if sp.g then
      groupParts[sp.g] = groupParts[sp.g] or {}
      groupParts[sp.g][#groupParts[sp.g] + 1] = p
    else
      p.Parent = model
    end
  end
  for _, sp in ipairs(specs.parts or {}) do
    if stats.parts >= (opts.maxParts or 3000) then break end
    local m, col = matOf(sp)
    local p
    pcall(function()
      local part = Instance.new("Part")
      if sp.shape == "ball" then part.Shape = Enum.PartShape.Ball end
      if sp.shape == "wedge" then part.Shape = Enum.PartShape.Wedge end
      if sp.shape == "file" then part.Shape = Enum.PartShape.File end
      if sp.shape == "coil" then part.Shape = Enum.PartShape.Coil end
      part.Anchored = true
      part.Massless = true
      part.CanCollide = true
      part.Material = Enum.Material[m] or Enum.Material.Plastic
      if col then part.Color = col end
      part.Size = Vector3.new(sp.size.x, sp.size.y, sp.size.z)
      part.CFrame = CFrame.new(sp.pos.x, sp.pos.y, sp.pos.z) * CFrame.Angles(0, sp.rotY or 0, 0)
      p = part
    end)
    if p then
      stats.parts = stats.parts + 1
      if sp._fbOf then
        heldFb[sp._fbOf] = heldFb[sp._fbOf] or {}
        heldFb[sp._fbOf][#heldFb[sp._fbOf] + 1] = { p = p, sp = sp, done = false }
      else
        placePart(p, sp)
      end
    end
    if stats.parts % 120 == 0 then
      prog(("%d parts..."):format(stats.parts))
      task.wait()
    end
  end

  -- 2) smooth ops: EditableMesh (mesh real de triângulos) → senão liberar fallback
  local maxEm = opts.maxEm or 8
  for _, sm in ipairs(specs.smooths or {}) do
    local cv, ct
    if sm.custom then cv, ct = sm.p and sm.p.verts, sm.p and sm.p.tris end
    cv = cv or sm.verts
    ct = ct or sm.tris
    local wantEm = cap.emesh and stats.em < maxEm
      and type(cv) == "table" and type(ct) == "table" and #ct > 0
      and (stats.tris + #ct) <= (opts.maxTris or 120000)
    local okM = false
    if wantEm then
      prog(("mesh real: %s (%d tris)..."):format(tostring(sm.gen), #ct))
      okM = pcall(function()
        local em = AS:CreateEditableMesh()
        local vids = {}
        for i, vt in ipairs(cv) do
          vids[i] = em:AddVertex(Vector3.new(vt[1] or vt.x or 0, vt[2] or vt.y or 0, vt[3] or vt.z or 0))
        end
        for _, tr in ipairs(ct) do
          em:AddTriangle(vids[tr[1]], vids[tr[2]], vids[tr[3]])
        end
        local mp = AS:CreateMeshPartAsync(Content.fromObject(em))
        local mm, cc = matOf(sm)
        local cfr = CFrame.new(0, 0, 0)
        if sm.cfr then
          cfr = CFrame.new(sm.cfr[1] or 0, sm.cfr[2] or 0, sm.cfr[3] or 0)
          if sm.cfr[4] then cfr = cfr * CFrame.Angles(0, sm.cfr[4], 0) end
        end
        mp.CFrame = cfr
        mp.Anchored = true
        mp.CanCollide = true
        mp.Material = Enum.Material[mm] or Enum.Material.Plastic
        if cc then mp.Color = cc end
        mp.Parent = model
        stats.meshes = stats.meshes + 1
        stats.tris = stats.tris + #ct
        stats.em = stats.em + 1
      end)
    end
    if not okM then
      -- libera as parts de fallback (retidas no passo 1)
      local held = heldFb[sm._id]
      if held then
        for _, item in ipairs(held) do
          item.done = true
          placePart(item.p, item.sp)
        end
      end
    end
    task.wait()
  end
  -- destrói fallbacks retidos cujo smooth virou mesh real
  for _, fb in pairs(heldFb) do
    for _, item in ipairs(fb) do
      if not item.done then pcall(function() item.p:Destroy() end) end
    end
  end

  -- 2) fusão booleana por grupo (meshes reais)
  local function fuseGroup(gname, plist)
    if #plist < 2 or not cap.union then return false end
    if #plist > 400 then return false end
    local main = plist[1]
    local others = {}
    for i = 2, #plist do others[i - 1] = plist[i] end
    local ok, res = pcall(function()
      return GS:UnionAsync(main, others, { CollisionFidelity = Enum.CollisionFidelity.Hull })
    end)
    if ok and type(res) == "table" and #res > 0 then
      local m, col = matOf(plist[1])
      for _, r in ipairs(res) do
        pcall(function()
          r.Parent = model
          r.CFrame = main.CFrame
          r.Anchored = true
          r.CanCollide = true
          r.Material = Enum.Material[m] or Enum.Material.Plastic
          if col then r.Color = col end
        end)
      end
      for _, o in ipairs(plist) do o.Parent = nil; pcall(function() o:Destroy() end) end
      stats.merged = stats.merged + 1
      stats.meshes = stats.meshes + #res
      return true
    end
    return false
  end

  local fnames = {}
  for k in pairs(groupParts) do fnames[#fnames + 1] = k end
  table.sort(fnames)
  for _, gn in ipairs(fnames) do
    local plist = groupParts[gn]
    prog(("fundindo '%s' (%d pçs)..."):format(tostring(gn):sub(1, 24), #plist))
    local okF = fuseGroup(gn, plist)
    if not okF then
      for _, p in ipairs(plist) do p.Parent = model end
    end
    task.wait()
  end

  -- 4) extras
  for _, ex in ipairs(specs.extras or {}) do
    pcall(function()
      if ex.type == "light" then
        local lp = Instance.new("Part")
        lp.Size = Vector3.new(0.6, 0.6, 0.6)
        lp.Position = Vector3.new(ex.pos.x, ex.pos.y, ex.pos.z)
        lp.Anchored = true
        lp.CanCollide = false
        lp.Material = Enum.Material.Neon
        local col = makeColor(ex.cor)
        if col then lp.Color = col end
        lp.Parent = model
        local lt
        if ex.tipo == "spot" then
          lt = Instance.new("SpotLight")
          lt.Angle = 60
        elseif ex.tipo == "surface" then
          lt = Instance.new("SurfaceLight")
        else
          lt = Instance.new("PointLight")
        end
        lt.Brightness = clamp(ex.int or 2, 0.1, 10)
        lt.Range = clamp(ex.range or 14, 2, 60)
        if col then lt.Color = col end
        lt.Parent = lp
      elseif ex.type == "particle" then
        local pp = Instance.new("Part")
        pp.Size = Vector3.new(2, 2, 2)
        pp.Position = Vector3.new(ex.pos.x, ex.pos.y, ex.pos.z)
        pp.Anchored = true
        pp.CanCollide = false
        pp.Transparency = 1
        pp.Parent = model
        local em = Instance.new("ParticleEmitter")
        em.Rate = clamp(ex.rate or 8, 0.5, 60)
        em.Lifetime = NumberRange.new(0.8, 2.2)
        em.Speed = NumberRange.new(1, 3)
        local dir = ex.dir
        em.DirectionalAngle = Vector2.new(20, 20)
        local col = makeColor(ex.cor)
        if ex.tipo == "fogo" then
          em.Color = ColorSequence.new(Color3.fromRGB(255, 180, 60), Color3.fromRGB(255, 60, 20))
          em.Size = NumberSequence.new(0.5, 0)
          em.Lifetime = NumberRange.new(0.4, 1)
        elseif ex.tipo == "fumaça" then
          em.Color = ColorSequence.new(Color3.fromRGB(150, 150, 150))
          em.Size = NumberSequence.new(0.8, 2.5)
          em.Transparency = NumberSequence.new(0.5, 1)
        elseif ex.tipo == "agua" then
          em.Color = ColorSequence.new(Color3.fromRGB(120, 190, 255))
          em.Size = NumberSequence.new(0.2, 0.4)
        elseif ex.tipo == "neve" then
          em.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
          em.Size = NumberSequence.new(0.08, 0.15)
          em.Speed = NumberRange.new(0.3, 0.8)
        else
          em.Color = ColorSequence.new(col or Color3.fromRGB(255, 230, 150))
          em.Size = NumberSequence.new(0.15, 0.02)
        end
        em.Parent = pp
      elseif ex.type == "beam" then
        local a1 = Instance.new("Part")
        a1.Size = Vector3.new(0.1, 0.1, 0.1)
        a1.Position = Vector3.new(ex.from.x, ex.from.y, ex.from.z)
        a1.Anchored = true; a1.CanCollide = false; a1.Transparency = 1
        a1.Parent = model
        local a2 = Instance.new("Part")
        a2.Size = Vector3.new(0.1, 0.1, 0.1)
        a2.Position = Vector3.new(ex.to.x, ex.to.y, ex.to.z)
        a2.Anchored = true; a2.CanCollide = false; a2.Transparency = 1
        a2.Parent = model
        local at1 = Instance.new("Attachment", a1)
        local at2 = Instance.new("Attachment", a2)
        local beam = Instance.new("Beam")
        beam.Attachment0 = at1
        beam.Attachment1 = at2
        beam.Width0 = ex.w or 0.15
        beam.Width1 = ex.w or 0.15
        local col = makeColor(ex.cor)
        if col then beam.Color = ColorSequence.new(col) end
        beam.FaceCamera = false
        beam.Parent = a1
      elseif ex.type == "placa" then
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.fromScale(0, 0)
        bb.StudsOffset = Vector3.new(0, 0.4, 0)
        bb.AlwaysOnTop = false
        local frame = Instance.new("Frame")
        frame.Size = UDim2.fromOffset(math.floor(ex.w * 12), math.floor(ex.h * 12))
        frame.BackgroundColor3 = Color3.fromRGB(30, 34, 44)
        frame.Parent = bb
        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.fromScale(1, 1)
        txt.BackgroundTransparency = 1
        txt.Text = ex.text or ""
        txt.TextColor3 = Color3.fromRGB(240, 240, 245)
        txt.TextScaled = true
        txt.Font = Enum.Font.GothamBold
        txt.Parent = frame
        local holder = Instance.new("Part")
        holder.Size = Vector3.new(0.2, 0.2, 0.2)
        holder.Position = Vector3.new(ex.pos.x, ex.pos.y, ex.pos.z)
        holder.Anchored = true; holder.CanCollide = false; holder.Transparency = 1
        holder.Parent = model
        bb.Parent = holder
      elseif ex.type == "tela" then
        local tp = Instance.new("Part")
        tp.Size = Vector3.new(ex.w, ex.h, 0.2)
        tp.Position = Vector3.new(ex.pos.x, ex.pos.y, ex.pos.z)
        tp.CFrame = CFrame.new(0, 0, 0) * CFrame.Angles(0, ex.rotY or 0, 0)
        tp.CFrame = tp.CFrame * CFrame.new(ex.pos.x - tp.CFrame.Position.X, ex.pos.y - tp.CFrame.Position.Y, ex.pos.z - tp.CFrame.Position.Z)
        tp.Anchored = true
        tp.Material = Enum.Material.BlackPlastic
        tp.Parent = model
        local col = makeColor(ex.cor)
        if col then tp.Color = col end
        local sg = Instance.new("SurfaceGui")
        sg.Size = Vector2.new(ex.w, ex.h)
        sg.Face = Enum.NormalId.Front
        sg.Parent = tp
        local f = Instance.new("Frame", sg)
        f.Size = UDim2.fromScale(1, 1)
        f.BackgroundColor3 = col or Color3.fromRGB(32, 36, 44)
      elseif ex.type == "decal" then
        local dp = Instance.new("Part")
        dp.Size = Vector3.new(ex.w, ex.h, 0.1)
        dp.Position = Vector3.new(ex.pos.x, ex.pos.y, ex.pos.z)
        dp.CFrame = dp.CFrame * CFrame.Angles(0, ex.rotY or 0, 0)
        dp.Anchored = true; dp.CanCollide = false
        dp.Material = Enum.Material.SmoothPlastic
        dp.Parent = model
        local dc = Instance.new("Decal")
        dc.Face = Enum.NormalId.Front
        dc.Transparency = 1 - (ex.opacidade or 0.8)
        if ex.asset and ex.asset ~= "" then dc.Texture = ex.asset end
        dc.Parent = dp
      end
    end)
  end

  -- 5) mood (Lighting)
  if specs.mood and specs.mood.luz then
    pcall(function()
      local L = game:GetService("Lighting")
      local Luz = specs.mood.luz:lower()
      if Luz == "noite" or Luz == "notte" then
        L.ClockTime = 22
        local atm = L:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere", L)
        atm.Density = 0.4; atm.Glare = 0.3; atm.Haze = 4
      elseif Luz == "entardecer" or Luz == "por_do_sol" then
        L.ClockTime = 18
        local atm = L:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere", L)
        atm.Density = 0.5; atm.Glare = 0.6; atm.Haze = 6
      elseif Luz == "neblina" or Luz == "chuva" then
        L.ClockTime = 12
        local atm = L:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere", L)
        atm.Density = 0.9; atm.Haze = 10
      else
        L.ClockTime = 14
      end
      if specs.mood.bloom and tonumber(specs.mood.bloom) > 0 then
        local b = L:FindFirstChildOfClass("Bloom") or Instance.new("Bloom", L)
        b.Intensity = clamp(tonumber(specs.mood.bloom) or 0.3, 0, 1)
      end
    end)
  end

  model.Parent = parent or WS
  prog(("pronto: %d parts, %d meshes fundidos, %d tris em mesh"):format(stats.parts, stats.merged, stats.tris))
  return model, stats
end

