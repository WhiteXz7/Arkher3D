local function callLLM(cfg, prompt, maxTokens)
    local req = {
        Url = cfg.base .. "/chat/completions",
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json",
            ["Authorization"] = "Bearer " .. cfg.key,
        },
        Body = HttpService:JSONEncode({
            model = cfg.model,
            temperature = 0.4,
            max_tokens = maxTokens or 8192,
            messages = {
                {role = "system", content = systemPrompt or SYSTEM_PROMPT},
                {role = "user", content = userPrompt},
            },
        }),
    }
    local ok, resp = pcall(function() return HttpService:RequestAsync(req) end)
    if not ok or type(resp) ~= "table" then
        return nil, "a API não respondeu (rede bloqueada? seu Studio Lite pode bloquear HTTP externo — nesse caso use a versão com server no PC). Detalhe: " .. tostring(resp):sub(1, 120)
    end
    if not resp.Success then
        local detail = tostring(resp.StatusMessage or "")
        local okd, dd = pcall(function() return HttpService:JSONDecode(resp.Body) end)
        if okd and type(dd) == "table" and dd.error then
            detail = tostring(dd.error.message or dd.error)
        end
        return nil, "HTTP " .. tostring(resp.StatusCode) .. " — " .. detail:sub(1, 150) .. "  (verifique token/modelo/URL no ⚙)"
    end
    local ok2, data = pcall(function() return HttpService:JSONDecode(resp.Body) end)
    if not ok2 or type(data) ~= "table" or not data.choices then
        return nil, "resposta inválida da IA: " .. tostring(resp.Body):sub(1, 150)
    end
    local msg = data.choices[1] and data.choices[1].message
    local text = msg and msg.content
    if not text or #text < 10 then
        return nil, "a IA respondeu vazio — tente de novo"
    end
    return text
end

local function validateLLM(cfg)
    local ok, err = callLLM(cfg, SYSTEM_PROMPT, "ok", 5)
    if ok then return true end
    return false, err
end

