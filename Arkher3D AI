local R3D2 = {}
R3D2.VERSION = "2.0"

-- ---------------- math pura ----------------
local function v3(x, y, z) return { x = x or 0, y = y or 0, z = z or 0 } end
function R3D2.v3(a, b, c)
  if type(a) == "table" then return v3(a[1] or a.x, a[2] or a.y, a[3] or a.z) end
  return v3(a, b, c)
end
local function vadd(a, b) return v3(a.x + b.x, a.y + b.y, a.z + b.z) end
local function vsub(a, b) return v3(a.x - b.x, a.y - b.y, a.z - b.z) end
local function vscale(a, s) return v3(a.x * s, a.y * s, a.z * s) end
local function vdot(a, b) return a.x * b.x + a.y * b.y + a.z * b.z end
local function vcross(a, b)
  return v3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x)
end
local function vlen(a) return math.sqrt(vdot(a, a)) end
local function vnorm(a)
  local l = vlen(a)
  if l < 1e-9 then return v3(0, 1, 0) end
  return vscale(a, 1 / l)
end
local function vlerp(a, b, t) return v3(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t) end
local function clamp(v, lo, hi) return math.min(math.max(v, lo), hi) end
R3D2._m = { v3 = v3, add = vadd, sub = vsub, scale = vscale, dot = vdot, cross = vcross,
            len = vlen, norm = vnorm, lerp = vlerp, clamp = clamp }

-- Catmull-Rom uniforme — amostra curva suave através de pts
function R3D2.catmullRom(pts, segPerSeg)
  local out = {}
  local n = #pts
  if n < 2 then return out end
  local s = math.max(1, math.floor(segPerSeg or 8))
  local function cr(p0, p1, p2, p3, t)
    local t2, t3 = t * t, t * t * t
    return v3(
      0.5 * ((2 * p1.x) + (-p0.x + p2.x) * t + (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * t2 + (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * t3),
      0.5 * ((2 * p1.y) + (-p0.y + p2.y) * t + (2 * p0.y - 5 * p1.y + 4 * p2.y - p3.y) * t2 + (-p0.y + 3 * p1.y - 3 * p2.y + p3.y) * t3),
      0.5 * ((2 * p1.z) + (-p0.z + p2.z) * t + (2 * p0.z - 5 * p1.z + 4 * p2.z - p3.z) * t2 + (-p0.z + 3 * p1.z - 3 * p2.z + p3.z) * t3))
  end
  for i = 1, n - 1 do
    local p0 = pts[i > 1 and i - 1 or 1]
    local p1 = pts[i]
    local p2 = pts[i + 1]
    local p3 = pts[math.min(n, i + 2)]
    for k = 0, s - 1 do
      out[#out + 1] = cr(p0, p1, p2, p3, k / s)
    end
  end
  out[#out + 1] = pts[n]
  return out
end

-- Arco: pontos ao longo de um círculo (ângulos em graus)
-- devolve {x,y,z,ang} onde ang = direção tangencial (rad)
function R3D2.arcPts(cx, cz, r, y, a0, a1, segs)
  local out = {}
  local s = math.max(2, math.floor(segs or 24))
  for i = 0, s do
    local t = (a0 + (a1 - a0) * i / s) * math.pi / 180
    out[#out + 1] = { x = cx + r * math.cos(t), y = y, z = cz + r * math.sin(t), ang = t }
  end
  return out
end

-- Esfera/cúpola lat-long → triângulos (winding pra fora)
-- rings: de +Y (topo) até -Y (se hemi, só até o equador)
function R3D2.sphereTris(cx, cy, cz, r, u, v, hemi)
  u = math.max(3, math.floor(u or 16))
  v = math.max(2, math.floor(v or (hemi and 8 or 12)))
  local verts, tris = {}, {}
  local rings = v + 1
  for ri = 0, rings - 1 do
    local phi
    if hemi then
      phi = (ri / v) * (math.pi / 2)          -- 0 = polo norte, 90° = equador
    else
      phi = (ri / v) * math.pi                -- 0 = norte, 180° = sul
    end
    local ringY = cy + r * math.cos(phi)
    local ringR = r * math.sin(phi)
    for ci = 0, u - 1 do
      local theta = (ci / u) * 2 * math.pi
      verts[#verts + 1] = { x = cx + ringR * math.cos(theta), y = ringY, z = cz + ringR * math.sin(theta) }
    end
  end
  local function id(ri, ci) return (ri * u + (ci % u)) + 1 end
  for ri = 0, v - 1 do
    local topFlat = (ri == 0)
    local botFlat = (ri == v - 1) and (not hemi)
    if topFlat then
      -- fan no polo norte (vértice 1..u da ring 0 todos iguais → usar id(0,0))
      for ci = 0, u - 2 do
        tris[#tris + 1] = { id(0, 0), id(1, ci + 1), id(1, ci) }
      end
    elseif botFlat then
      for ci = 0, u - 2 do
        tris[#tris + 1] = { id(ri + 1, 0), id(ri, ci), id(ri, ci + 1) }
      end
    else
      for ci = 0, u - 1 do
        -- anéis da esfera vão de NORTE (ri) p/ SUL (ri+1) → winding espelhado vs lathe
        local a, b = id(ri, ci), id(ri, ci + 1)
        local c, d = id(ri + 1, ci), id(ri + 1, ci + 1)
        tris[#tris + 1] = { a, b, c }
        tris[#tris + 1] = { b, d, c }
      end
    end
  end
  return verts, tris
end

-- Lathe: perfil [[r, y], ...] girado em torno de Y (em (cx, cy, cz))
function R3D2.latheTris(profile, segs, cx, cy, cz)
  segs = math.max(3, math.floor(segs or 24))
  if type(profile) ~= "table" or #profile < 2 then return nil, nil end
  local verts, tris = {}, {}
  local n = #profile
  -- anéis: um por ponto de perfil (r pode ser 0 nos polos)
  for pi = 1, n do
    local rr, yy = profile[pi][1] or 0, profile[pi][2] or 0
    for ci = 0, segs - 1 do
      local th = (ci / segs) * 2 * math.pi
      verts[#verts + 1] = { x = cx + rr * math.cos(th), y = cy + yy, z = cz + rr * math.sin(th) }
    end
  end
  local function id(pi, ci) return ((pi - 1) * segs + (ci % segs)) + 1 end
  -- centróide Y do perfil → decide se um polo é de "topo" (winding A) ou "base" (winding B)
  local ycent = 0
  for _, pp in ipairs(profile) do ycent = ycent + (pp[2] or 0) end
  ycent = ycent / n
  -- fan: P = polo, R(ci) = anel vizinho. topo: {P, R(ci+1), R(ci)} | base: {P, R(ci), R(ci+1)}
  local function fan(poleId, ringIdx, poleY)
    local topo = poleY >= ycent
    for ci = 0, segs - 2 do
      if topo then
        tris[#tris + 1] = { poleId, id(ringIdx, ci + 1), id(ringIdx, ci) }
      else
        tris[#tris + 1] = { poleId, id(ringIdx, ci), id(ringIdx, ci + 1) }
      end
    end
  end
  for pi = 1, n - 1 do
    local rTop = profile[pi][1] or 0
    local rBot = profile[pi + 1][1] or 0
    if rTop < 1e-4 and rBot < 1e-4 then
      -- dois polos: pular
    elseif rTop < 1e-4 then
      fan(id(pi, 0), pi + 1, profile[pi][2] or 0)
    elseif rBot < 1e-4 then
      fan(id(pi + 1, 0), pi, profile[pi + 1][2] or 0)
    else
      for ci = 0, segs - 1 do
        local a, b = id(pi, ci), id(pi, ci + 1)
        local c, d = id(pi + 1, ci), id(pi + 1, ci + 1)
        tris[#tris + 1] = { a, c, b }
        tris[#tris + 1] = { b, c, d }
      end
    end
  end
  return verts, tris
end

-- Sweep: fatia retangular (w × h) ao longo de pts → triângulos (tubo/fia/caminho)
-- corte: "rect" (w, h) ou "circle" (r)
function R3D2.sweepTris(pts, w, h, corte, segPer)
  local samples = R3D2.catmullRom(pts, segPer)
  local n = #samples
  if n < 2 then return nil, nil end
  local verts, tris = {}, {}
  local k = corte == "circle" and math.max(6, math.floor((w or 1) * 8 + 4)) or 4
  -- perfis por amostra: vetores do corte em torno da tangente
  local profs = {}
  for si = 1, n do
    local p = samples[si]
    local t = vnorm(vsub(samples[math.min(n, si + 1)], samples[math.max(1, si - 1)]))
    local up = v3(0, 1, 0)
    if math.abs(vdot(t, up)) > 0.92 then up = v3(0, 0, 1) end
    local nrm = vnorm(vcross(up, t))     -- lateral
    local bin = vcross(t, nrm)           -- "cima" do tubo
    local ring = {}
    if corte == "circle" then
      local r = (w or 1) / 2
      for ci = 1, k do
        local a = ((ci - 1) / k) * 2 * math.pi
        ring[ci] = vadd(vscale(nrm, r * math.cos(a)), vscale(bin, r * math.sin(a)))
      end
    else
      local hw, hh = (w or 1) / 2, (h or w or 1) / 2
      -- retângulo de 4 vértices: topo-esq, topo-dir, baixo-dir, baixo-esq
      ring[1] = vadd(vscale(nrm, -hw), vscale(bin, hh))
      ring[2] = vadd(vscale(nrm, hw), vscale(bin, hh))
      ring[3] = vadd(vscale(nrm, hw), vscale(bin, -hh))
      ring[4] = vadd(vscale(nrm, -hw), vscale(bin, -hh))
      k = 4
    end
    profs[si] = { ring = ring, t = t, p = p }
  end
  -- emitir vértices (n × k) e faixas de quads (winding: olhando de dentro pra fora)
  for si = 1, n do
    for ci = 1, k do
      verts[#verts + 1] = vadd(profs[si].p, profs[si].ring[ci])
    end
  end
  local function vid(si, ci) return (si - 1) * k + ci end
  for si = 1, n - 1 do
    for ci = 1, k do
      local c2 = (ci % k) + 1
      local a, b = vid(si, ci), vid(si + 1, ci)
      local c, d = vid(si, c2), vid(si + 1, c2)
      -- winding: normal deve apontar pra fora (lado de nrm)
      local e1 = vsub(verts[b], verts[a])
      local e2 = vsub(verts[c], verts[a])
      local nrm = vcross(e1, e2)
      local outDir = profs[si].ring[ci]
      if vdot(nrm, outDir) < 0 then
        tris[#tris + 1] = { a, c, b }
        tris[#tris + 1] = { b, c, d }
      else
        tris[#tris + 1] = { a, b, c }
        tris[#tris + 1] = { b, d, c }
      end
    end
  end
  return verts, tris
end

-- Escada
function R3D2.stairs(from, to, w, steps)
  local f, t = R3D2.v3(from), R3D2.v3(to)
  steps = math.max(2, math.floor(steps or 10))
  local out = {}
  local dy = t.y - f.y
  local run = vsub(t, f); run.y = 0
  local l = vlen(run)
  if l < 1e-6 then return out end
  local dir = vscale(run, 1 / l)
  for i = 0, steps - 1 do
    local c = vadd(f, vadd(vscale(dir, l * (i + 0.5) / steps), v3(0, dy * (i + 0.5) / steps, 0)))
    out[#out + 1] = {
      pos = c,
      size = { math.max(0.5, w), math.max(0.1, dy / steps), l / steps * 1.08 },
      rotY = math.atan(dir.x, dir.z),
    }
  end
  return out
end

-- Parede com aberturas reais (porta/janela)
-- from/to: extremos (mesma y), h: altura, t: espessura
-- openings: [{pos=0..1, w=largura, h=altura, tipo="porta"|"janela"}]
function R3D2.wall(from, to, h, t, openings)
  local f, t2 = R3D2.v3(from), R3D2.v3(to)
  local l = vlen(vsub(t2, f))
  if l < 0.1 then return { parts = {}, openings = {} } end
  local dir = vscale(vsub(t2, f), 1 / l)
  local rotY = math.atan(dir.x, dir.z)
  local parts, ops = {}, {}
  h = math.max(0.3, h or 3)
  t = math.max(0.2, t or 0.5)
  -- corte os segmentos sólidos
  local cuts = { { 0, 0 } }  -- {início, fim} em metros
  local o = {}
  for _, op in ipairs(openings or {}) do
    local p = clamp(op.pos or 0.5, 0.02, 0.98)
    local w = clamp(op.w or 1.5, 0.4, l * 0.9)
    o[#o + 1] = { a = l * p - w / 2, b = l * p + w / 2, w = w, h = math.min(h, op.h or 2.2), tipo = op.tipo or "janela" }
  end
  table.sort(o, function(x, y) return x.a < y.a end)
  local cursor = 0
  -- eixos: local Z = ao longo da parede (rotY = atan2(dir.x, dir.z)), local X = espessura
  local function seg(a, b)
    if b - a > 0.08 then
      local c = vadd(f, vadd(vscale(dir, (a + b) / 2), v3(0, h / 2, 0)))
      parts[#parts + 1] = { pos = c, size = { t, h, b - a }, rotY = rotY }
    end
  end
  for _, op in ipairs(o) do
    seg(cursor, math.max(cursor, op.a))
    -- lintel (acima da abertura)
    if op.h < h - 0.05 then
      local c = vadd(f, vadd(vscale(dir, (op.a + op.b) / 2), v3(0, (h + op.h) / 2, 0)))
      parts[#parts + 1] = { pos = c, size = { t, h - op.h, op.w }, rotY = rotY }
    end
    -- peitoril (abaixo, só janela)
    if op.tipo ~= "porta" and op.h < h then
      local c = vadd(f, vadd(vscale(dir, (op.a + op.b) / 2), v3(0, (h - op.h) / 2, 0)))
      parts[#parts + 1] = { pos = c, size = { t, h - op.h, op.w }, rotY = rotY }
    end
    local center = vadd(f, vadd(vscale(dir, (op.a + op.b) / 2), v3(0, op.h / 2, 0)))
    ops[#ops + 1] = { pos = center, w = op.w, h = op.h, tipo = op.tipo, rotY = rotY }
    cursor = math.max(cursor, op.b)
  end
  seg(cursor, l)
  return { parts = parts, openings = ops }
end

-- Telhado em 2 águas: cumeeira A→B, pitch (0..1, altura/comp_água), width
function R3D2.roof(A, B, pitch, width, rows)
  local a, b = R3D2.v3(A), R3D2.v3(B)
  local ab = vsub(b, a); ab.y = 0
  local l = vlen(ab)
  if l < 0.2 then return {} end
  local dir = vscale(ab, 1 / l)
  local rotY = math.atan(dir.x, dir.z)
  rows = math.max(2, math.floor(rows or 5))
  pitch = clamp(pitch or 0.5, 0.08, 1.5)
  width = math.max(0.5, width or 4)
  local out = {}
  local step = (width / 2) / rows
  for side = 1, 2 do
    local sgn = side == 1 and 1 or -1
    for r = 0, rows - 1 do
      -- fileiro r: parte da cumeeira (r=0) e desce a água
      local horiz = (width / 2) * (r + 0.5) / rows      -- distância horizontal da cumeeira
      local yy = pitch * (width / 2) - pitch * horiz    -- altura da água nesse ponto
      local mid = vlerp(a, b, 0.5)
      local perp = v3(dir.z * sgn, 0, -dir.x * sgn)
      local c = vadd(vadd(mid, vscale(perp, horiz)), v3(0, yy, 0))
      out[#out + 1] = {
        pos = c,
        size = { step * 1.4, 0.14, l + 0.4 },
        rotY = rotY,
      }
    end
  end
  return out
end

