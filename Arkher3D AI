    -- A posição fica guardada p/ a próxima sessão, assim você
    -- deixa o botão "estacionado" num canto vazio da UI.
    -- ============================================================
    local UIS = game:GetService("UserInputService")
    local mem
    do
        local ok, v = pcall(function() return _G.R3D_UI_MEM end)
        if ok and v then mem = v end
    end
    local function persistPos(pos)
        local x = pos.X * gui.AbsoluteSize.X + pos.XOffset
        local y = pos.Y * gui.AbsoluteSize.Y + pos.YOffset
        mem = {x = x, y = y}
        pcall(function()
            _G.R3D_UI_MEM = mem
            local rs = game:GetService("ReplicatedStorage")
            local m = rs:FindFirstChild("Roblox3D_UI_State")
            if not m then
                m = Instance.new("ModuleScript")
                m.Name = "Roblox3D_UI_State"
                m.Parent = rs
            end
            m.Source = string.format("return {x = %.1f, y = %.1f}", x, y)
        end)
    end
    local function savedPos()
        if mem and mem.x then return mem.x, mem.y end
        local ok, v = pcall(function()
            local m = game:GetService("ReplicatedStorage"):FindFirstChild("Roblox3D_UI_State")
            if not m then return nil end
            return require(m)
        end)
        if ok and v and v.x then return v.x, v.y end
        return nil, nil
    end

    local spx, spy = savedPos()
    if spx then
        toggle.Position = UDim2.new(0, spx, 0, spy)
    end

    local function clampXY(x, y)
        local s = gui.AbsoluteSize
        local w, h = toggle.AbsoluteSize.X, toggle.AbsoluteSize.Y
        return math.clamp(x, 0, math.max(0, s.X - w)), math.clamp(y, 0, math.max(0, s.Y - h))
    end

    local function isPointer(t)
        return t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1
    end

    local drag = {active = false, moved = false, startInput = nil, startPos = nil, absSize = nil}
    toggle.InputBegan:Connect(function(input)
        if isPointer(input.UserInputType) then
            drag.active = true
            drag.moved = false
            drag.startInput = input.Position
            drag.startPos = toggle.Position
            drag.absSize = gui.AbsoluteSize
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not drag.active then return end
        if input.UserInputType ~= Enum.UserInputType.Touch
            and input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
        local dx = input.Position.X - drag.startInput.X
        local dy = input.Position.Y - drag.startInput.Y
        if not drag.moved and (math.abs(dx) > 6 or math.abs(dy) > 6) then
            drag.moved = true
        end
        if drag.moved then
            local ax = drag.startPos.X * drag.absSize.X + drag.startPos.XOffset + dx
            local ay = drag.startPos.Y * drag.absSize.Y + drag.startPos.YOffset + dy
            local cx, cy = clampXY(ax, ay)
            toggle.Position = UDim2.new(0, cx, 0, cy)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if not drag.active or not isPointer(input.UserInputType) then return end
        local wasDrag = drag.moved
        drag.active = false
        if wasDrag then
            persistPos(toggle.Position)
        else
            toggle()
        end
    end)

    closeBtn.MouseButton1Click:Connect(function()
        uiState.open = false
        panel.Visible = false
    end)

    -- boas-vindas
