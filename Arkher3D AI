local SYSTEM_PROMPT = "Você é um modelador 3D especialista em Roblox (estilo low-poly DETALHADO e realista). Responda SEMPRE SOMENTE com JSON válido — sem markdown, sem texto antes ou depois."


local function findLast(s, sub)
    local last, pos = nil, 1
    while true do
        local i = s:find(sub, pos, true)
        if not i then break end
        last = i
        pos = i + 1
    end
    return last
end

local function extractJson(text)
    local s = text:match("^%s*(.-)%s*$")
    if s:sub(1, 3) == "```" then
        s = s:gsub("^%s*```[a-z]*%s*\n?", "")
        s = s:gsub("\n?%s*```%s*$", "")
    end
    local first = s:find("{", 1, true)
    local last = findLast(s, "}")
    if not first or not last or last <= first then
        error("JSON não encontrado na resposta do modelo")
    end
    local jsonStr = s:sub(first, last)
    local ok, data = pcall(HttpService.JSONDecode, HttpService, jsonStr)
    if not ok or type(data) ~= "table" then
        error("JSON inválido: " .. tostring(data):sub(1, 150))
    end
    return data
end

