local AI_STATE_NAME = "Roblox3D_AI_State"
local AI_DEFAULTS = {
    base = "https://api.puter.com/puterai/openai/v1",
    key = "",
    model = "gpt-5.4-nano",
}

local function loadCfg()
    local cfg = {base = AI_DEFAULTS.base, key = "", model = AI_DEFAULTS.model}
    local ok, mem = pcall(function() return _G.R3D_AI_MEM end)
    if ok and type(mem) == "table" then
        if mem.base and mem.base ~= "" then cfg.base = mem.base end
        if mem.key and mem.key ~= "" then cfg.key = mem.key end
        if mem.model and mem.model ~= "" then cfg.model = mem.model end
    end
    if cfg.key == "" then
        local ok2, m = pcall(function()
            local ms = game:GetService("ReplicatedStorage"):FindFirstChild(AI_STATE_NAME)
            if not ms then return nil end
            return require(ms)
        end)
        if ok2 and type(m) == "table" and m.key and m.key ~= "" then
            cfg.key = m.key
            if m.base and m.base ~= "" then cfg.base = m.base end
            if m.model and m.model ~= "" then cfg.model = m.model end
        end
    end
    cfg.base = cfg.base:gsub("/+$", "")
    return cfg
end

local aiCfg = loadCfg()

local function saveCfg(cfg)
    aiCfg = cfg
    pcall(function()
        _G.R3D_AI_MEM = {base = cfg.base, key = cfg.key, model = cfg.model}
        local rs = game:GetService("ReplicatedStorage")
        local m = rs:FindFirstChild(AI_STATE_NAME)
        if not m then
            m = Instance.new("ModuleScript")
            m.Name = AI_STATE_NAME
            m.Parent = rs
        end
        m.Source = string.format("return {base = %q, key = %q, model = %q}",
            cfg.base, cfg.key, cfg.model)
    end)
end

