local VALID_KIND = {box = true, cylinder = true, sphere = true}

local function hexToRgb(h)
    h = h:gsub("^#", ""):lower()
    if #h == 3 then
        h = h:sub(1, 1) .. h:sub(1, 1) .. h:sub(2, 2) .. h:sub(2, 2) .. h:sub(3, 3) .. h:sub(3, 3)
    end
    return tonumber(h:sub(1, 2), 16) or 255,
        tonumber(h:sub(3, 4), 16) or 255,
        tonumber(h:sub(5, 6), 16) or 255
end

local function clamp255(v) return math.min(255, math.max(0, v)) end

local function normalizeScene(data)
    local name = tostring(data.name or "modelo"):gsub("[^%a%d_]+", "_"):sub(1, 40)
    if name == "" then name = "modelo" end
    local parts = {}
    local raw = data.parts or {}
    local maxParts = 300
    for i = 1, math.min(#raw, maxParts) do
        local p = raw[i]
        if type(p) == "table" and #p >= 6 and type(p[2]) == "table" and type(p[3]) == "table" then
            local kind = tostring(p[1]):lower()
            if VALID_KIND[kind] then
                local rawSize = p[2]
                local size = {}
                -- box precisa de 3 dimensões; cylinder de 2 (raio, altura); sphere de 1+
                local need = (kind == "box") and 3 or ((kind == "cylinder") and 2 or 1)
                local okSize = #rawSize >= need
                for i = 1, 3 do
                    local v = rawSize[i]
                    if v ~= nil then
                        if type(v) ~= "number" or v <= 0.01 or v > 300 then
                            okSize = false
                            break
                        end
                        size[i] = v
                    end
                end
                if okSize then
                    if kind == "cylinder" then size[4] = 24 end
                    local pos = {p[3][1] or 0, p[3][2] or 0, p[3][3] or 0}
                    local okPos = true
                    for _, v in ipairs(pos) do
                        if type(v) ~= "number" or math.abs(v) > 400 then okPos = false break end
                    end
                    if okPos then
                        local rotSrc = (#p > 3 and type(p[4]) == "table") and p[4] or {0, 0, 0}
                        local rot = {rotSrc[1] or 0, rotSrc[2] or 0, rotSrc[3] or 0}
                        local mat = tostring(p[5] or "plastico"):lower():gsub("-", "_")
                        if not VALID_TEX[mat] then mat = "plastico" end
                        local color = p[6]
                        local rgb
                        if type(color) == "string" then
                            rgb = {hexToRgb(color)}
                        elseif type(color) == "table" then
                            rgb = {clamp255(color[1] or 200), clamp255(color[2] or 200), clamp255(color[3] or 200)}
                        else
                            rgb = {200, 200, 200}
                        end
                        local nm = tostring(#p > 6 and p[7] or ("Part" .. (#parts + 1))):gsub("[^%a%d_]+", "_"):sub(1, 24)
                        if nm == "" then nm = "Part" .. (#parts + 1) end
                        table.insert(parts, {kind, size, pos, rot, mat, rgb, nm})
                    end
                end
            end
        end
    end
    return {name = name, parts = parts}
end

local function callLLM(cfg, prompt, maxTokens)
    local req = {
        Url = cfg.base .. "/chat/completions",
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json",
            ["Authorization"] = "Bearer " .. cfg.key,
        },
        Body = HttpService:JSONEncode({
            model = cfg.model,
            temperature = 0.4,
            max_tokens = maxTokens or 8192,
            messages = {
                {role = "system", content = SYSTEM_PROMPT},
                {role = "user", content = prompt},
            },
        }),
    }
    local ok, resp = pcall(function() return HttpService:RequestAsync(req) end)
    if not ok or type(resp) ~= "table" then
        return nil, "a API não respondeu (rede bloqueada? seu Studio Lite pode bloquear HTTP externo — nesse caso use a versão com server no PC). Detalhe: " .. tostring(resp):sub(1, 120)
    end
    if not resp.Success then
        local detail = tostring(resp.StatusMessage or "")
        local okd, dd = pcall(function() return HttpService:JSONDecode(resp.Body) end)
        if okd and type(dd) == "table" and dd.error then
            detail = tostring(dd.error.message or dd.error)
        end
        return nil, "HTTP " .. tostring(resp.StatusCode) .. " — " .. detail:sub(1, 150) .. "  (verifique token/modelo/URL no ⚙)"
    end
    local ok2, data = pcall(function() return HttpService:JSONDecode(resp.Body) end)
    if not ok2 or type(data) ~= "table" or not data.choices then
        return nil, "resposta inválida da IA: " .. tostring(resp.Body):sub(1, 150)
    end
    local msg = data.choices[1] and data.choices[1].message
    local text = msg and msg.content
    if not text or #text < 10 then
        return nil, "a IA respondeu vazio — tente de novo"
    end
    return text
end

local function validateLLM(cfg)
    local ok, err = callLLM(cfg, "ok", 5)
    if ok then return true end
    return false, err
end

