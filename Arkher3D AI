local TEX_SIZE = 128

local function hash2(ix, iz, seed)
    local h = (ix * 374761393 + iz * 668265263 + seed * 1442695041) % 2147483647
    if h < 0 then h = h + 2147483647 end
    return h / 2147483647
end
local function smoothstep(t) return t * t * (3 - 2 * t) end
local function valueNoise(x, y, seed)
    local ix, iy = math.floor(x), math.floor(y)
    local fx, fy = x - ix, y - iy
    local a = hash2(ix, iy, seed)
    local b = hash2(ix + 1, iy, seed)
    local c = hash2(ix, iy + 1, seed)
    local d = hash2(ix + 1, iy + 1, seed)
    local sx, sy = smoothstep(fx), smoothstep(fy)
    return a + (b - a) * sx + (c - a) * sy + (a - b - c + d) * sx * sy
end
local function fbm(x, y, seed)
    local v, amp, freq = 0, 0.5, 1
    for i = 1, 4 do
        v = v + amp * valueNoise(x * freq, y * freq, seed + i * 101)
        amp = amp * 0.5
        freq = freq * 2
    end
    return v
end

local function n2(u, v, s) return fbm(u * 14, v * 14, s) end
local function n1(u, v, s) return fbm(u * 6, v * 6, s) end

local samplers = {
    metal = function(u, v, b, s)
        local f = (0.75 + 0.5 * (n2(u, v, s) - 0.5)) * (0.9 + 0.2 * (n1(u * 3, v, s + 7) - 0.5))
        return b[1] * f, b[2] * f, b[3] * f
    end,
    stone = function(u, v, b, s)
        local n = 0.7 + 0.6 * (n2(u, v, s) - 0.5)
        local strata = 1 - 0.14 * math.abs(math.sin(v * math.pi * 6 + (n1(u, v, s + 3) - 0.5) * 3))
        local crack = (n1(u * 2, v * 2, s + 11) > 0.83) and 0.75 or 1
        local f = n * strata * crack
        return b[1] * f, b[2] * f, b[3] * f
    end,
    brick = function(u, v, b, s)
        local row = math.floor(v * 8)
        local off = (row % 2) * 0.5
        local lx = (u * 16 + off) % 1
        local ly = (v * 8) % 1
        local mortar = (ly < 0.09 or lx < 0.09) and 0.6 or 1
        local f = (0.8 + 0.4 * (n2(u, v, s) - 0.5)) * mortar
        return b[1] * f, b[2] * f, b[3] * f
    end,
    marble = function(u, v, b, s)
        local vein = math.abs(fbm(u * 2.2 + 3.7, v * 3.4, s) - 0.5)
        local vein2 = math.abs(fbm(u * 4.1, v * 1.7 + 8.2, s + 5) - 0.5)
        local f = 0.94 + 0.12 * (n2(u, v, s) - 0.5)
        if vein < 0.055 then f = f * 0.55 end
        if vein2 < 0.05 then f = f * 0.78 end
        return b[1] * f, b[2] * f, b[3] * f
    end,
    wood = function(u, v, b, s)
        local grain = 0.75 + 0.5 * math.sin(u * 42 + fbm(u * 2, v * 6, s) * 8)
        local f = (0.8 + 0.4 * (n2(u, v, s) - 0.5)) * grain
        return b[1] * f, b[2] * f, b[3] * f
    end,
    earth = function(u, v, b, s)
        local f = (0.7 + 0.6 * (n2(u, v, s) - 0.5)) * (0.85 + 0.3 * (n1(u, v, s + 5) - 0.5))
        local pebble = (n1(u * 3, v * 3, s + 9) > 0.8) and 1.15 or 1
        local g = f * pebble
        return b[1] * g, b[2] * g, b[3] * g
    end,
    thatch = function(u, v, b, s)
        local streak = 0.7 + 0.6 * (n1(u, v * 3, s) - 0.5)
        local n = 0.8 + 0.4 * (n2(u * 2, v * 2, s + 3) - 0.5)
        local f = streak * n
        return b[1] * f, b[2] * f, b[3] * f
    end,
    grass = function(u, v, b, s)
        local f = (0.72 + 0.55 * (n2(u, v, s) - 0.5)) * (0.85 + 0.3 * (n1(u, v, s + 4) - 0.5))
        return b[1] * f, b[2] * f, b[3] * f
    end,
    sand = function(u, v, b, s)
        local f = (0.85 + 0.3 * (n2(u, v, s) - 0.5)) * (0.9 + 0.2 * (n1(u * 3, v, s + 6) - 0.5))
        return b[1] * f, b[2] * f, b[3] * f
    end,
    water = function(u, v, b, s)
        local w = 0.8 + 0.35 * (fbm(u * 3, v * 3 + 1.3, s) - 0.5)
        local ripple = 0.9 + 0.2 * math.sin((u + v) * 30 + fbm(u * 5, v * 5, s + 2) * 6)
        local f = w * ripple
        return b[1] * f, b[2] * f, b[3] * f
    end,
    fabric = function(u, v, b, s)
        local f = (0.82 + 0.36 * (n2(u * 2, v * 2, s) - 0.5)) * (0.9 + 0.2 * (n1(u, v, s + 2) - 0.5))
        return b[1] * f, b[2] * f, b[3] * f
    end,
    leather = function(u, v, b, s)
        local f = (0.78 + 0.44 * (n2(u, v, s) - 0.5)) * (0.88 + 0.24 * (n1(u * 2, v * 2, s + 3) - 0.5))
        return b[1] * f, b[2] * f, b[3] * f
    end,
    ice = function(u, v, b, s)
        local vein = math.abs(fbm(u * 2.5, v * 3.2 + 5, s) - 0.5)
        local f = 0.92 + 0.16 * (n2(u, v, s) - 0.5)
        if vein < 0.06 then f = f * 0.72 end
        return b[1] * f, b[2] * f, b[3] * f
    end,
}

