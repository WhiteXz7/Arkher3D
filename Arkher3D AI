-- CONSTRUTOR DE CENAS
-- ============================================================
local building = false

local function buildScene(scene, atPosition, status)
    local model = Instance.new("Model")
    model.Name = "Roblox3D_" .. tostring(scene.name or "modelo")
    model:SetAttribute("Roblox3D", true)
    local parts = scene.parts or {}
    local total = #parts
    local made = 0
    local firstPart = nil
    for i = 1, total do
        local s = parts[i]
        local part
        if s[1] == "box" then
            part = Instance.new("Part")
            part.Size = Vector3.new(s[2][1], s[2][2], s[2][3])
        elseif s[1] == "cylinder" then
            part = Instance.new("MeshPart")
            part.MeshId = "rbxasset://Meshes/cylinder_main"
            part.Size = Vector3.new(s[2][1] * 2, s[2][2], s[2][1] * 2)
        else
            part = Instance.new("MeshPart")
            part.MeshId = "rbxasset://Meshes/ball_main"
            part.Size = Vector3.new(s[2][1] * 2, (s[2][2] or s[2][1]) * 2, (s[2][3] or s[2][1]) * 2)
        end
        part.Name = s[7] or ("Part" .. i)
        part.Anchored = true
        part.CFrame = CFrame.new(s[3][1], s[3][2], s[3][3])
            * CFrame.fromEulerAnglesXYZ(math.rad(s[4][1]), math.rad(s[4][2]), math.rad(s[4][3]))
        applyLook(part, s[5], s[6])
        part.Parent = model
        if not firstPart then firstPart = part end
        made = made + 1
        if made % 25 == 0 or made == total then
            status(string.format("construindo… %d/%d", made, total))
        end
        if made % 40 == 0 then task.wait() end
    end
    model.PrimaryPart = firstPart
    if atPosition then
        pcall(function() model:PivotTo(atPosition) end)
    end
    model.Parent = workspace
    return model, made
end

local function playerAnchor()
    local player = Players.LocalPlayer
    local char = player and player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return Vector3.new(0, 0, 0), 0 end
    local forward = hrp.CFrame.LookVector
    forward = Vector3.new(forward.X, 0, forward.Z)
    if forward.Magnitude < 0.1 then forward = Vector3.new(0, 0, -1) end
    forward = forward.Unit
    local pos = hrp.Position + forward * 20
    pos = Vector3.new(pos.X, hrp.Position.Y - 3, pos.Z)
    local yaw = math.atan2(forward.X, forward.Z) * 180 / math.pi
    return pos, yaw
end

