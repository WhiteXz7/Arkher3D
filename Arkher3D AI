local R3D2 = (function()
-- ============================================================
-- R3D2 — motor de modelagem v2 (fontes única; embutida nos 2 clients)
--   Camada 1: ops paramétricas (curvas/domes/cupolas/lathe/sweep)
--             → código faz a matemática, a IA só desenha
