function R3D2.summarize(ops)
  local lines = {}
  for i, op in ipairs(ops or {}) do
    if #lines >= 50 then break end
    local p = op.center or op.pos or op.from or op.a or (op.pts and op.pts[1]) or { 0, 0, 0 }
    lines[#lines + 1] = string.format("%d) %s p=(%.1f,%.1f,%.1f)",
      i, tostring(op.t or op.tipo or "?"), p[1] or 0, p[2] or 0, p[3] or 0)
  end
  if ops and #ops > 50 then
    lines[#lines + 1] = string.format("(%d ops a mais…)", #ops - 50)
  end
  return table.concat(lines, "\n")
end

