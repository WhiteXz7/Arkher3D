                :format(CAPS.union and "ON" or "OFF", CAPS.emesh and "ON" or "OFF (curvas viram anéis de caixas orientadas)")

            -- ETAPA 1: PLANO (arquiteto divide o trabalho em seções + orçamento)
            local okP, planRaw = callLLM(aiCfg, SYSTEM_PROMPT, R3D2.promptsPlan(text, BUDGET), 8192)
            if not okP then fail(planRaw) return end
            local okPJ, plan = pcall(extractJson, planRaw)
            if not okPJ or type(plan) ~= "table" then
                fail("a IA respondeu o plano sem JSON válido — tente de novo")
                return
            end
            local secs = plan.secoes or plan.sections or {}
            if #secs == 0 then secs = { {t = "modelo", nota = text, orc = BUDGET} } end

            -- ETAPA 2: SEÇÕES (a IA desenha ops; o motor calcula a geometria real)
            local allOps = {}
            local builtSummary = ""
            for i, sec in ipairs(secs) do
                local secBudget = math.floor(tonumber(sec.orc) or (BUDGET / #secs))
                setStatus(string.format("seção %d/%d: %s", i, #secs, tostring(sec.t or "?"):sub(1, 36)), Y)
                local okS, sRaw = callLLM(aiCfg, SYSTEM_PROMPT,
                    R3D2.promptsSection(plan, i, sec, secBudget, builtSummary, capInfo), 8192)
                if not okS then fail(sRaw) return end
                local okSJ, sData = pcall(extractJson, sRaw)
                if okSJ and type(sData) == "table" and type(sData.ops) == "table" then
                    for _, op in ipairs(sData.ops) do allOps[#allOps + 1] = op end
                else
                    addMsg(string.format("⚠ seção %d/%d não devolveu ops válidas — seguindo sem ela", i, #secs), Y)
                end
                builtSummary = R3D2.summarize(allOps)
            end

            -- ETAPA 3: DECOR + MOOD (luzes, partículas, neon, letreiros, atmosfera)
            setStatus("decor e atmosfera…", Y)
            local mood = nil
            local okD, dRaw = callLLM(aiCfg, SYSTEM_PROMPT, R3D2.promptsDecor(plan, builtSummary), 8192)
            if okD then
                local okDJ, dData = pcall(extractJson, dRaw)
                if okDJ and type(dData) == "table" then
                    if type(dData.extras) == "table" then
                        for _, op in ipairs(dData.extras) do allOps[#allOps + 1] = op end
                    end
                    if type(dData.mood) == "table" then mood = dData.mood end
                end
            else
                addMsg("⚠ decor falhou (segui sem luzes/efeitos): " .. tostring(dRaw):sub(1, 80), Y)
            end
            if not mood and type(plan.mood) == "string" and plan.mood ~= "" then
                mood = { luz = plan.mood }
            end

            -- EXPAND + BUILD (orçamento de 3000 parts aplicado aqui)
            local specs, eErr = R3D2.expandOps({ ops = allOps }, { budget = BUDGET, emOk = CAPS.emesh })
            if not specs then fail("expansão falhou: " .. tostring(eErr)) return end
            if mood then specs.mood = mood end
            local planName = tostring(plan.nome or plan.name or "modelo")
            local total = specs.stats.parts
            if total < 3 then
                fail("a IA devolveu quase nada — reenvie o pedido (ou detalhe mais).")
                return
            end
            specs.name = planName
            if specs.stats.truncated then
                addMsg(string.format("⚠ pediu mais que o orçamento: cortado em %d parts (máx. %d).", total, BUDGET), Y)
            end
            local pos, yaw = playerAnchor()
            setStatus("construindo… 0/" .. total, Y)
            local model, stats = buildScene(specs, CFrame.new(pos) * CFrame.fromEulerAnglesY(math.rad(yaw)), function(t)
                setStatus(t, Y)
            end)
            building = false
            if not model or not stats then fail("falha ao construir no Roblox — tente de novo") return end
            setStatus("pronto", Color3.fromRGB(120, 200, 140))
            local extra = ""
            if stats.merged > 0 or stats.tris > 0 then
                extra = string.format(" (%d fundições booleanas, %d tris em mesh real)", stats.merged, stats.tris)
            end
            addMsg(string.format("✅ %s construído: %d parts%s! Está NA FRENTE do seu avatar — aproxime e entre. No Explorer: Workspace > %s (organize à vontade).",
                planName, stats.parts, extra, model.Name), Color3.fromRGB(140, 230, 170))
        end)
    end
