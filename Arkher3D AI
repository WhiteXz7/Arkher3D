function R3D2.matName(nome)
  if type(nome) ~= "string" then return "Plastic" end
  local k = nome:lower():gsub("%s+", "_")
  return MAT[k] or "Plastic"
end

function R3D2.hexToRgb(h)
  if type(h) ~= "string" then return nil end
  local s = h:match("^#?%x+") or ""
  if #s == 3 then s = s:sub(1, 1) .. s:sub(1, 1) .. s:sub(2, 2) .. s:sub(2, 2) .. s:sub(3, 3) .. s:sub(3, 3) end
  if #s < 6 then return nil end
  local r, g, b = tonumber(s:sub(1, 2), 16), tonumber(s:sub(3, 4), 16), tonumber(s:sub(5, 6), 16)
  if not (r and g and b) then return nil end
  return r, g, b
end

-- ---------------- expandOps: DSL → specs ----------------
-- spec part:  {type="part", pos, size, rotY?, shape?, mat, cor, g?}
-- spec mesh:  {type="smooth", gen="dome|lathe|sweep|arc|sphere", p=..., mat, cor, g?, fb=[parts]}
-- spec extra: {type="light"|"particle"|"beam"|"placa"|"tela"|"decal", ...}

local function clampNum(v, lo, hi, dft)
  if type(v) ~= "number" or v ~= v then return dft end
  return clamp(v, lo, hi)
end

local function addPart(ctx, spec)
  if ctx.stats.parts >= ctx.budget then
    ctx.stats.truncated = true
    return false
  end
  spec.pos = R3D2.v3(spec.pos)
  if math.abs(spec.pos.y) > 400 or math.abs(spec.pos.x) > 500 or math.abs(spec.pos.z) > 500 then
    return false
  end
  ctx.stats.parts = ctx.stats.parts + 1
  ctx.parts[#ctx.parts + 1] = spec
  return true
end

local smoothCount = 0
local function addSmooth(ctx, spec, fbParts)
  -- custo = nº de fallback parts (pior caso sem mesh)
  smoothCount = smoothCount + 1
  spec._id = smoothCount
  local cost = #fbParts
  if ctx.stats.parts + cost > ctx.budget then
    ctx.stats.truncated = true
    cost = math.max(0, ctx.budget - ctx.stats.parts)
  end
  for i = 1, cost do
    ctx.stats.parts = ctx.stats.parts + 1
    fbParts[i]._fbOf = spec._id
    ctx.parts[#ctx.parts + 1] = fbParts[i]
  end
  spec.fbCount = cost
  ctx.smooths[#ctx.smooths + 1] = spec
end

local function partSpec(ctx, op)
  local pos = R3D2.v3(op.pos)
  local size = R3D2.v3(op.size)
  if size.x < 0.03 or size.y < 0.03 or size.z < 0.03 then return end
  if size.x > 300 or size.y > 300 or size.z > 300 then return end
  addPart(ctx, {
    type = "part",
    pos = pos,
    size = size,
    rotY = math.rad(op.rot and op.rot[2] or (op.rotY or 0)),
    shape = op.shape,
    mat = op.mat,
    cor = op.cor,
    g = op.g,
  })
end

local OPS = {}

function OPS.box(op, ctx)
  partSpec(ctx, op)
end

function OPS.cyl(op, ctx)
  local r = clampNum(op.r, 0.05, 150, 1)
  local h = clampNum(op.h, 0.05, 300, 2)
  local pos = R3D2.v3(op.pos)
  local segs = math.floor(clampNum(op.segs, 4, 64, 20))
  local mat = op.mat or "plastico"
  local cor = op.cor
  local g = op.g
  -- fallback: anel de caixas
  local per = math.max(4, math.floor(segs))
  local fb = {}
  local chord = 2 * r * math.sin(math.pi / per)
  for i = 0, per - 1 do
    local a = (i / per) * 2 * math.pi
    fb[#fb + 1] = {
      type = "part",
      pos = v3(pos.x + r * math.cos(a), pos.y, pos.z + r * math.sin(a)),
      size = v3(chord * 1.05, h, chord * 1.05),
      rotY = -a,
      mat = mat, cor = cor, g = g,
    }
  end
  if op.smooth ~= false and segs > 8 then
    -- mesh: lathe simples (cilindro com topo/base fechados)
    local profile = { { 0, -h / 2 }, { r, -h / 2 }, { r, h / 2 }, { 0, h / 2 } }
    local verts, tris = R3D2.latheTris(profile, segs, 0, 0, 0)
    if verts and #tris > 0 then
      addSmooth(ctx, {
        type = "smooth", gen = "lathe",
        p = { profile = profile, segs = segs },
        cfr = { pos.x, pos.y, pos.z },
        mat = mat, cor = cor, g = g,
        verts = verts, tris = tris,
      }, fb)
      return
    end
  end
  for i = 1, #fb do
    if ctx.stats.parts >= ctx.budget then ctx.stats.truncated = true break end
    ctx.stats.parts = ctx.stats.parts + 1
    ctx.parts[#ctx.parts + 1] = fb[i]
  end
end

function OPS.arc(op, ctx)
  local cx, cz = (op.center and op.center[1]) or 0, (op.center and op.center[3]) or 0
  local r = clampNum(op.r, 0.3, 300, 5)
  local y = clampNum(op.y or (op.center and op.center[2]) or 0, -200, 400, 0)
  local h = clampNum(op.h, 0.1, 200, 2)
  local w = clampNum(op.w or op.t, 0.2, 50, 0.8)
  local a0, a1 = clampNum(op.a0, -360, 720, 0), clampNum(op.a1, -360, 720, 180)
  local segs = math.floor(clampNum(op.segs, 4, 200, 32))
  local mat = op.mat or "pedra"
  local cor = op.cor
  local g = op.g or "arc_" .. ctx.stats.parts
  local pts = R3D2.arcPts(cx, cz, r, y + h / 2, a0, a1, segs)
  local sweepLen = r * math.abs(a1 - a0) * math.pi / 180
  local stepLen = sweepLen / #pts * 1.15
  -- fallback: caixas tangenciais
  local fb = {}
  for _, p in ipairs(pts) do
    fb[#fb + 1] = {
      type = "part",
      pos = v3(p.x, p.y, p.z),
      size = v3(w, h, stepLen),
      rotY = -p.ang,
      mat = mat, cor = cor, g = g,
    }
  end
  -- mesh: ribbon ao longo do arco (se segs razoável)
  if op.smooth ~= false and #pts >= 6 then
    local mpts = {}
    for _, p in ipairs(pts) do mpts[#mpts + 1] = v3(p.x, p.y, p.z) end
    local verts, tris = R3D2.sweepTris(mpts, stepLen, h, "rect", 2)
    if verts and #tris > 0 then
      addSmooth(ctx, {
        type = "smooth", gen = "sweep",
        p = { pts = mpts, w = stepLen, h = h },
        mat = mat, cor = cor, g = g,
        verts = verts, tris = tris,
      }, fb)
      return
    end
  end
  for i = 1, #fb do
    if ctx.stats.parts >= ctx.budget then ctx.stats.truncated = true break end
    ctx.stats.parts = ctx.stats.parts + 1
    ctx.parts[#ctx.parts + 1] = fb[i]
  end
end

function OPS.ring(op, ctx)
  local c = op.center or { 0, 0, 0 }
  local cx, cy, cz = c[1], c[2], c[3]
  local r0 = clampNum(op.r0, 0, 300, 3)
  local r1 = clampNum(op.r1, 0.1, 300, 5)
  if r1 <= r0 then r1 = r0 + 1 end
  local h = clampNum(op.h, 0.05, 100, 0.4)
  local segs = math.floor(clampNum(op.segs, 8, 128, 48))
  local mat = op.mat or "plastico"
  local cor = op.cor
  local g = op.g or "ring_" .. ctx.stats.parts
  local rMid = (r0 + r1) / 2
  local w = r1 - r0
  local pts = R3D2.arcPts(cx, cz, rMid, cy + h / 2, 0, 360, segs)
  local stepLen = (2 * math.pi * rMid) / #pts * 1.18
  local fb = {}
  for _, p in ipairs(pts) do
    fb[#fb + 1] = {
      type = "part",
      pos = v3(p.x, p.y, p.z),
      size = v3(w, h, stepLen),
      rotY = -p.ang,
      mat = mat, cor = cor, g = g,
    }
  end
  if op.smooth ~= false and #pts >= 10 then
    local mpts = {}
    for _, p in ipairs(pts) do mpts[#mpts + 1] = v3(p.x, p.y, p.z) end
    -- fecha o loop
    mpts[#mpts + 1] = v3(mpts[1].x, mpts[1].y, mpts[1].z)
    local verts, tris = R3D2.sweepTris(mpts, w, h, "rect", 2)
    if verts and #tris > 0 then
      addSmooth(ctx, { type = "smooth", gen = "sweep", p = { pts = mpts, w = w, h = h }, mat = mat, cor = cor, g = g, verts = verts, tris = tris }, fb)
      return
    end
  end
  for i = 1, #fb do
    if ctx.stats.parts >= ctx.budget then ctx.stats.truncated = true break end
    ctx.stats.parts = ctx.stats.parts + 1
    ctx.parts[#ctx.parts + 1] = fb[i]
  end
end

function OPS.dome(op, ctx)
  local c = op.center or { 0, 0, 0 }
  local cx, cy, cz = c[1], c[2], c[3]
  local r = clampNum(op.r, 0.3, 200, 5)
  local u = math.floor(clampNum(op.u, 6, 64, 20))
  local vv = math.floor(clampNum(op.v or op.rings, 3, 32, 9))
  local h = op.h  -- altura opcional do domo (se não, hemisfério)
  local mat = op.mat or "concreto"
  local cor = op.cor
  local g = op.g or "dome_" .. ctx.stats.parts
  local verts, tris = R3D2.sphereTris(cx, cy, cz, r, u, vv, true)
  -- fallback: caixas lat-long
  local fb = {}
  local cellW = (2 * math.pi * r) / u * 1.3
  for ri = 1, vv do
    local phi = (ri / vv) * math.pi / 2
    local ringR = r * math.sin(phi)
    local ringY = cy + r * math.cos(phi)
    local nInRing = math.max(3, math.floor(u * math.sin(phi)))
    local depth = math.max(0.35, 2 * ringR * math.sin(math.pi / nInRing)) * 1.15
    for ci = 0, nInRing - 1 do
      local th = (ci / nInRing) * 2 * math.pi
      fb[#fb + 1] = {
        type = "part",
        pos = v3(cx + ringR * math.cos(th), ringY, cz + ringR * math.sin(th)),
        size = v3(depth, (r * math.pi / 2 / vv) * 1.5, cellW),
        rotY = -th,
        mat = mat, cor = cor, g = g,
      }
    end
  end
  addSmooth(ctx, { type = "smooth", gen = "dome", p = { center = { cx, cy, cz }, r = r, u = u, v = vv }, mat = mat, cor = cor, g = g, verts = verts, tris = tris }, fb)
end

function OPS.sphere(op, ctx)
  local c = op.center or op.pos or { 0, 1, 0 }
  local cx, cy, cz = c[1], c[2], c[3]
  local r = clampNum(op.r, 0.1, 150, 1.5)
  local u = math.floor(clampNum(op.u, 6, 64, 14))
  local vv = math.floor(clampNum(op.v, 4, 32, 8))
  local mat = op.mat or "plastico"
  local cor = op.cor
  local g = op.g or "sph_" .. ctx.stats.parts
  local verts, tris = R3D2.sphereTris(cx, cy, cz, r, u, vv, false)
  local fb = {}
  for ri = 0, vv do
    local phi = (ri / vv) * math.pi
    local ringR = r * math.sin(phi)
    local ringY = cy + r * math.cos(phi)
    local nInRing = math.max(3, math.floor(u * math.sin(phi)))
    local cellW = (2 * math.pi * r) / u * 1.3
    for ci = 0, nInRing - 1 do
      local th = (ci / nInRing) * 2 * math.pi
      fb[#fb + 1] = {
        type = "part",
        pos = v3(cx + ringR * math.cos(th), ringY, cz + ringR * math.sin(th)),
        size = v3(cellW * 0.9, (2 * math.pi * r / vv) * 0.6, cellW),
        rotY = -th,
        mat = mat, cor = cor, g = g,
      }
    end
  end
  addSmooth(ctx, { type = "smooth", gen = "sphere", p = { center = { cx, cy, cz }, r = r, u = u, v = vv }, mat = mat, cor = cor, g = g, verts = verts, tris = tris }, fb)
end

function OPS.lathe(op, ctx)
  local c = op.center or { 0, 0, 0 }
  local cx, cy, cz = c[1], c[2], c[3]
  local profile = op.profile
  local segs = math.floor(clampNum(op.segs, 6, 96, 24))
  local mat = op.mat or "plastico"
  local cor = op.cor
  local g = op.g or "lathe_" .. ctx.stats.parts
  if type(profile) ~= "table" or #profile < 2 then return end
  local verts, tris = R3D2.latheTris(profile, segs, 0, 0, 0)
  -- fallback: anéis de caixas
  local fb = {}
  local maxR = 0
  for _, pp in ipairs(profile) do maxR = math.max(maxR, pp[1] or 0) end
  for pi = 1, #profile - 1 do
    local rMid = ((profile[pi][1] or 0) + (profile[pi + 1][1] or 0)) / 2
    local yMid = (profile[pi][2] or 0) + ((profile[pi + 1][2] or 0) - (profile[pi][2] or 0)) / 2
    if rMid > 0.02 then
      local hSeg = math.max(0.15, (profile[pi + 1][2] or 0) - (profile[pi][2] or 0))
      local n = math.max(6, math.floor(segs * math.min(1, rMid / math.max(0.5, maxR))))
      local cellW = (2 * math.pi * rMid) / n * 1.2
      for ci = 0, n - 1 do
        local th = (ci / n) * 2 * math.pi
        fb[#fb + 1] = {
          type = "part",
          pos = v3(cx + rMid * math.cos(th), cy + yMid, cz + rMid * math.sin(th)),
          size = v3(cellW * 0.8, hSeg * 1.1, cellW),
          rotY = -th,
          mat = mat, cor = cor, g = g,
        }
      end
    end
  end
  addSmooth(ctx, { type = "smooth", gen = "lathe", p = { profile = profile, segs = segs }, cfr = { cx, cy, cz }, mat = mat, cor = cor, g = g, verts = verts, tris = tris }, fb)
end

function OPS.sweep(op, ctx)
  local raw = op.pts
  if type(raw) ~= "table" or #raw < 2 then return end
  local pts = {}
  for i = 1, #raw do pts[i] = R3D2.v3(raw[i]) end
  local w = clampNum(op.w, 0.05, 60, 1)
  local h = clampNum(op.h or op.w, 0.05, 60, 1)
  local corte = op.corte or "rect"
  local segPer = math.floor(clampNum(op.seg or op.segs, 2, 24, 6))
  local mat = op.mat or "plastico"
  local cor = op.cor
  local g = op.g or "sw_" .. ctx.stats.parts
  local verts, tris = R3D2.sweepTris(pts, w, h, corte, segPer)
  -- fallback: caixas ao longo da curva
  local fb = {}
  local samples = R3D2.catmullRom(pts, segPer)
  for i = 1, #samples do
    local p = samples[i]
    local p2 = samples[math.min(#samples, i + 1)] or samples[1]
    local segLen = vlen(vsub(p2, p))
    local t = vnorm(vsub(p2, samples[math.max(1, i - 1)]))
    fb[#fb + 1] = {
      type = "part",
      pos = p,
      size = v3(w, h, math.max(0.6, segLen * 1.35)),
      rotY = math.atan(t.x, t.z),
      mat = mat, cor = cor, g = g,
    }
  end
  if verts and #tris > 0 then
    addSmooth(ctx, { type = "smooth", gen = "sweep", p = { pts = pts, w = w, h = h, corte = corte }, mat = mat, cor = cor, g = g, verts = verts, tris = tris }, fb)
    return
  end
  for i = 1, #fb do
    if ctx.stats.parts >= ctx.budget then ctx.stats.truncated = true break end
    ctx.stats.parts = ctx.stats.parts + 1
    ctx.parts[#ctx.parts + 1] = fb[i]
  end
end

function OPS.stair(op, ctx)
  local from = op.from or op.pos or { 0, 0, 0 }
  local to = op.to or vadd(R3D2.v3(from), v3(0, 2, 6))
  local w = clampNum(op.w, 0.6, 30, 2)
  local steps = math.floor(clampNum(op.steps, 2, 60, 10))
  local mat = op.mat or "concreto"
  local cor = op.cor
  local g = op.g
  for _, st in ipairs(R3D2.stairs(from, to, w, steps)) do
    addPart(ctx, { type = "part", pos = st.pos, size = st.size, rotY = st.rotY, mat = mat, cor = cor, g = g })
  end
end

function OPS.wall(op, ctx)
  local from = op.from or { 0, 0, 0 }
  local to = op.to or vadd(R3D2.v3(from), v3(10, 0, 0))
  local h = clampNum(op.h, 0.5, 60, 3.2)
  local t = clampNum(op.t or op.thick, 0.2, 6, 0.5)
  local mat = op.mat or "tijolo"
  local cor = op.cor
  local g = op.g or "wall_" .. ctx.stats.parts
  local res = R3D2.wall(from, to, h, t, op.openings)
  for _, p in ipairs(res.parts) do
    addPart(ctx, { type = "part", pos = p.pos, size = p.size, rotY = p.rotY, mat = mat, cor = cor, g = g })
  end
  -- aberturas: porta/janela com moldura + vidro
  for _, o in ipairs(res.openings) do
    local fm = op.moldura or "madeira"
    local fh = clampNum(op.moldura_h, 0.08, 0.6, 0.25)
    local cx, cy, cz = o.pos.x, o.pos.y, o.pos.z
    local dirx, dirz = math.sin(o.rotY), math.cos(o.rotY)
    local fw = o.w
    local fhgt = o.h
    local s = t + 0.12
    -- montantes (laterais)
    addPart(ctx, { type = "part", pos = v3(cx - dirx * fw / 2, cy + fhgt / 2, cz - dirz * fw / 2), size = v3(s, fhgt, fh), rotY = o.rotY, mat = fm, cor = op.moldura_cor, g = g })
    addPart(ctx, { type = "part", pos = v3(cx + dirx * fw / 2, cy + fhgt / 2, cz + dirz * fw / 2), size = v3(s, fhgt, fh), rotY = o.rotY, mat = fm, cor = op.moldura_cor, g = g })
    -- verga (topo)
    addPart(ctx, { type = "part", pos = v3(cx, cy + fhgt / 2 + fh / 2, cz), size = v3(s, fh, fw + fh), rotY = o.rotY, mat = fm, cor = op.moldura_cor, g = g })
    -- peitoril (só janela)
    if o.tipo ~= "porta" then
      addPart(ctx, { type = "part", pos = v3(cx, cy - fhgt / 2 + fh / 2, cz), size = v3(s, fh, fw), rotY = o.rotY, mat = fm, cor = op.moldura_cor, g = g })
    end
    -- vidro / folha da porta
    if o.tipo == "janela" then
      addPart(ctx, { type = "part", pos = v3(cx, cy, cz), size = v3(t * 0.5, fhgt - fh, fw - fh), rotY = o.rotY, mat = "vidro", cor = "#bfe3ff", g = g })
    else
      addPart(ctx, { type = "part", pos = v3(cx, cy, cz), size = v3(t * 0.8, fhgt - fh, fw - fh), rotY = o.rotY, mat = "madeira", cor = op.cor or "#5b3a21", g = g })
      -- maçaneta
      addPart(ctx, { type = "part", pos = v3(cx + dirx * fw * 0.32, cy, cz + dirz * fw * 0.32), size = v3(0.12, 0.12, 0.12), mat = "metal", cor = "#e8c25a", g = g })
    end
  end
end

function OPS.roof(op, ctx)
  local A = op.a or op.from or { 0, 3, -4 }
  local B = op.b or op.to or { 0, 3, 4 }
  local pitch = clampNum(op.pitch, 0.08, 1.5, 0.5)
  local width = clampNum(op.w or op.width, 1, 60, 8)
  local rows = math.floor(clampNum(op.rows, 2, 24, 6))
  local mat = op.mat or "tijolo"
  local cor = op.cor
  local g = op.g or "roof_" .. ctx.stats.parts
  for _, r in ipairs(R3D2.roof(A, B, pitch, width, rows)) do
    addPart(ctx, { type = "part", pos = r.pos, size = r.size, rotY = r.rotY, mat = mat, cor = cor, g = g })
  end
end

function OPS.column(op, ctx)
  local pos = R3D2.v3(op.pos)
  local r = clampNum(op.r, 0.1, 20, 0.5)
  local hh = clampNum(op.h, 0.5, 80, 4)
  local mat = op.mat or "marmore"
  local cor = op.cor
  local g = op.g
  -- base + coluna (cyl liso) + capital
  addPart(ctx, { type = "part", pos = v3(pos.x, pos.y + 0.15, pos.z), size = v3(r * 2.8, 0.3, r * 2.8), mat = mat, cor = cor, g = g })
  OPS.cyl({ pos = { pos.x, pos.y + hh / 2 + 0.3, pos.z }, r = r, h = hh, segs = op.segs or 16, mat = mat, cor = cor, g = g }, ctx)
  addPart(ctx, { type = "part", pos = v3(pos.x, pos.y + hh + 0.36, pos.z), size = v3(r * 2.8, 0.32, r * 2.8), mat = mat, cor = cor, g = g })
end

function OPS.window(op, ctx)
  local pos = R3D2.v3(op.pos)
  local w = clampNum(op.w, 0.5, 20, 1.5)
  local h = clampNum(op.h, 0.5, 20, 2)
  local t = clampNum(op.t or op.thick, 0.1, 2, 0.3)
  local rotY = math.rad(op.rot or op.facing or 0)
  local fm = op.mat or "madeira"
  local fh = 0.22
  local g = op.g
  local dx, dz = math.sin(rotY), math.cos(rotY)
  -- moldura (largura ao longo da parede = local Z)
  addPart(ctx, { type = "part", pos = v3(pos.x - dx * w / 2, pos.y + h / 2, pos.z - dz * w / 2), size = v3(t, h, fh), rotY = rotY, mat = fm, g = g })
  addPart(ctx, { type = "part", pos = v3(pos.x + dx * w / 2, pos.y + h / 2, pos.z + dz * w / 2), size = v3(t, h, fh), rotY = rotY, mat = fm, g = g })
  addPart(ctx, { type = "part", pos = v3(pos.x, pos.y + h / 2, pos.z), size = v3(t, fh, w + fh), rotY = rotY, mat = fm, g = g })
  addPart(ctx, { type = "part", pos = v3(pos.x, pos.y, pos.z), size = v3(t, fh, w), rotY = rotY, mat = fm, g = g })
  -- vidro
  addPart(ctx, { type = "part", pos = v3(pos.x, pos.y + h / 2, pos.z), size = v3(t * 0.4, h - fh, w - fh), rotY = rotY, mat = "vidro", cor = "#bfe3ff", g = g })
end

function OPS.door(op, ctx)
  local pos = R3D2.v3(op.pos)
  local w = clampNum(op.w, 0.8, 12, 1.7)
  local h = clampNum(op.h, 1, 16, 3)
  local t = clampNum(op.t or op.thick, 0.1, 2, 0.3)
  local rotY = math.rad(op.rot or op.facing or 0)
  local fm = op.mat or "madeira"
  local fh = 0.24
  local g = op.g
  local dx, dz = math.sin(rotY), math.cos(rotY)
  addPart(ctx, { type = "part", pos = v3(pos.x - dx * w / 2, pos.y + h / 2, pos.z - dz * w / 2), size = v3(t, h, fh), rotY = rotY, mat = fm, g = g })
  addPart(ctx, { type = "part", pos = v3(pos.x + dx * w / 2, pos.y + h / 2, pos.z + dz * w / 2), size = v3(t, h, fh), rotY = rotY, mat = fm, g = g })
  addPart(ctx, { type = "part", pos = v3(pos.x, pos.y + h - fh / 2, pos.z), size = v3(t, fh, w + fh), rotY = rotY, mat = fm, g = g })
  addPart(ctx, { type = "part", pos = v3(pos.x, pos.y + h / 2 - fh / 2, pos.z), size = v3(t * 0.7, h - fh, w - fh), rotY = rotY, mat = "madeira", cor = op.cor or "#5b3a21", g = g })
  addPart(ctx, { type = "part", pos = v3(pos.x + dx * w * 0.3, pos.y + h * 0.45, pos.z + dz * w * 0.3), size = v3(0.14, 0.14, 0.14), mat = "metal", cor = "#e8c25a", g = g })
end

function OPS.fence(op, ctx)
  local from = op.from or { 0, 0, 0 }
  local to = op.to or vadd(R3D2.v3(from), v3(10, 0, 0))
  local h = clampNum(op.h, 0.5, 10, 1.2)
  local rails = math.floor(clampNum(op.rails, 1, 5, 3))
  local mat = op.mat or "madeira"
  local cor = op.cor
  local g = op.g
  local f, t2 = R3D2.v3(from), R3D2.v3(to)
  local l = vlen(vsub(t2, f))
  local dir = vscale(vsub(t2, f), 1 / math.max(1e-6, l))
  local rotY = math.atan(dir.x, dir.z)
  local nPost = math.max(2, math.floor(l / clampNum(op.post, 0.5, 10, 2)) + 1)
  for i = 0, nPost - 1 do
    local c = vadd(f, vscale(dir, i / math.max(1, nPost - 1) * l))
    addPart(ctx, { type = "part", pos = v3(c.x, c.y + h / 2, c.z), size = v3(0.18, h, 0.18), mat = mat, cor = cor, g = g })
  end
  for r = 1, rails do
    local yy = (f.y or 0) + h * r / rails
    local mid = vlerp(f, t2, 0.5)
    addPart(ctx, { type = "part", pos = v3(mid.x, yy, mid.z), size = v3(0.12, 0.12, l), rotY = rotY, mat = mat, cor = cor, g = g })
  end
end

function OPS.tree(op, ctx)
  local pos = R3D2.v3(op.pos)
  local hh = clampNum(op.h, 2, 40, 8)
  local typ = op.tipo or "redondo"
  local matT = "madeira"
  local matF = op.folhas or "grama"
  local corF = op.cor or nil
  local g = op.g or "tree_" .. ctx.stats.parts
  local trunkH = hh * 0.45
  OPS.cyl({ pos = { pos.x, pos.y + trunkH / 2, pos.z }, r = hh * 0.06, h = trunkH, segs = 10, mat = matT, cor = "#6b4a2b", g = g }, ctx)
  if typ == "palm" then
    local cy = pos.y + trunkH
    for i = 0, 5 do
      local a = i / 5 * 2 * math.pi
      addPart(ctx, { type = "part", pos = v3(pos.x + math.cos(a) * hh * 0.3, cy + 0.2, pos.z + math.sin(a) * hh * 0.3), size = v3(hh * 0.14, 0.18, hh * 0.5), rotY = math.pi / 2 - a, mat = matF, cor = corF, g = g })
    end
  elseif typ == "pine" then
    for i = 0, 2 do
      local ry = pos.y + trunkH + i * hh * 0.2
      local rr = hh * (0.32 - i * 0.08)
      OPS.cyl({ pos = { pos.x, ry + hh * 0.1, pos.z }, r = rr, h = hh * 0.24, segs = 12, mat = matF, cor = corF, g = g }, ctx)
    end
  else
    OPS.dome({ center = { pos.x, pos.y + trunkH + hh * 0.15, pos.z }, r = hh * 0.35, u = 12, v = 6, mat = matF, cor = corF, g = g }, ctx)
    OPS.sphere({ center = { pos.x + hh * 0.18, pos.y + trunkH + hh * 0.05, pos.z + hh * 0.12 }, r = hh * 0.22, u = 10, v = 5, mat = matF, cor = corF, g = g }, ctx)
  end
end

function OPS.rock(op, ctx)
  local pos = R3D2.v3(op.pos)
  local s = clampNum(op.s or op.size, 0.5, 40, 2)
  local n = math.floor(clampNum(op.n or op.pedras, 3, 14, 6))
  local mat = op.mat or "pedra"
  local cor = op.cor
  local g = op.g or "rock_" .. ctx.stats.parts
  for i = 1, n do
    local a = (i / n) * 2 * math.pi + i * 1.7
    local rr = s * 0.4 * ((i * 37 % 10) / 10 + 0.4)
    local sz = s * (0.35 + ((i * 53 % 10) / 10) * 0.4)
    addPart(ctx, {
      type = "part",
      pos = v3(pos.x + math.cos(a) * rr, pos.y + sz * 0.3, pos.z + math.sin(a) * rr),
      size = v3(sz, sz * 0.7, sz * 0.9),
      rotY = a * 2,
      shape = "wedge",
      mat = mat, cor = cor, g = g,
    })
  end
end

function OPS.mesh(op, ctx)
  -- triângulos custom (só com EditableMesh ativo; senão caixa de contorno)
  local verts, tris = op.verts, op.tris
  if type(verts) ~= "table" or type(tris) ~= "table" or #verts < 3 or #tris < 1 then return end
  local pos = R3D2.v3(op.pos or { 0, 0, 0 })
  local mat = op.mat or "plastico"
  local cor = op.cor
  local triCost = math.min(#tris, 20000)
  -- caixa delimitadora (fallback sem EditableMesh)
  local minx, miny, minz, maxx, maxy, maxz = 1e9, 1e9, 1e9, -1e9, -1e9, -1e9
  for _, vt in ipairs(verts) do
    minx = math.min(minx, vt[1] or 0); miny = math.min(miny, vt[2] or 0); minz = math.min(minz, vt[3] or 0)
    maxx = math.max(maxx, vt[1] or 0); maxy = math.max(maxy, vt[2] or 0); maxz = math.max(maxz, vt[3] or 0)
  end
  local bbox = { {
    type = "part",
    pos = v3(pos.x + (minx + maxx) / 2, pos.y + (miny + maxy) / 2, pos.z + (minz + maxz) / 2),
    size = v3(math.max(0.3, maxx - minx), math.max(0.3, maxy - miny), math.max(0.3, maxz - minz)),
    mat = mat, cor = cor,
  } }
  if triCost > 200 and (not ctx.emOk) then
    addPart(ctx, bbox[1])
    return
  end
  addSmooth(ctx, {
    type = "smooth", gen = "custom",
    p = { verts = verts, tris = tris },
    cfr = { pos.x, pos.y, pos.z, math.rad(op.rot or op.rotY or 0) },
    mat = mat, cor = cor, g = op.g,
    custom = true,
  }, bbox)
  ctx.stats.triEm = (ctx.stats.triEm or 0) + triCost
end

-- extras (não consomem budget de parts)
